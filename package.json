{
  "name": "enclave",
  "private": true,
  "version": "0.1.0",
  "description": "Enclave — plataforma privada de comunidade, mensagens, voz, vídeo e bots",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @enclave/web build && pnpm --filter @enclave/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @enclave/server test",
    "test:e2e": "pnpm --filter @enclave/e2e test",
    "db:generate": "pnpm --filter @enclave/server db:generate",
    "db:migrate": "pnpm --filter @enclave/server db:migrate",
    "create-owner": "pnpm --filter @enclave/server create-owner"
  }
}
