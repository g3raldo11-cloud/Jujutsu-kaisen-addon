# ── Ouroboros · configuração de ambiente ──
NODE_ENV=production
APP_URL=https://comunidade.exemplo.com
PORT=4000
# Gere com: openssl rand -base64 48
APP_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
TRUST_PROXY=true

DATABASE_URL=postgres://ouroboros:ouroboros@postgres:5432/ouroboros
REDIS_URL=redis://redis:6379

# E-mail (obrigatório em produção — verificação de e-mail e recuperação de senha)
SMTP_URL=smtp://usuario:senha@smtp.exemplo.com:587
MAIL_FROM=Ouroboros <no-reply@exemplo.com>

# Armazenamento privado: local ou s3 (MinIO, AWS S3, R2…)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ouroboros
S3_ACCESS_KEY=ouroboros
S3_SECRET_KEY=troque-esta-senha
S3_FORCE_PATH_STYLE=true

# WebRTC — sem TURN, chamadas podem falhar atrás de NAT simétrico/firewalls corporativos
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.exemplo.com:3478?transport=udp,turn:turn.exemplo.com:3478?transport=tcp
TURN_SECRET=mesmo-valor-de-static-auth-secret-do-coturn

# Antivírus opcional (clamd)
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Bot de IA (opcional; também pode ser configurado pelo proprietário no painel)
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5

# Busca de GIFs (Tenor) — opcional
# GIF_PROVIDER_KEY=
