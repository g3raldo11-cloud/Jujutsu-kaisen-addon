# ── Ouroboros · configuração de ambiente ──
# Produção: copie para .env, preencha os valores e rode `docker compose up -d --build`.
# Desenvolvimento: veja "Rodando localmente" no README (a maioria dos valores tem padrão).

NODE_ENV=production
# Domínio público (o Caddy emite o certificado HTTPS automaticamente)
DOMAIN=comunidade.exemplo.com
APP_URL=https://comunidade.exemplo.com
# Gere com: openssl rand -base64 48
APP_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
LOG_LEVEL=info

# Banco de dados (usado pelo docker-compose; em desenvolvimento use DATABASE_URL diretamente)
POSTGRES_PASSWORD=troque-esta-senha
# DATABASE_URL=postgres://ouroboros:ouroboros@localhost:5432/ouroboros
# REDIS_URL=redis://localhost:6379

# E-mail — obrigatório em produção (confirmação de cadastro e recuperação de senha)
SMTP_URL=smtp://usuario:senha@smtp.exemplo.com:587
MAIL_FROM=Ouroboros <no-reply@exemplo.com>

# Armazenamento privado de arquivos: local (volume /data/storage) ou s3 (MinIO, AWS S3, R2…)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ouroboros
S3_ACCESS_KEY=ouroboros
S3_SECRET_KEY=troque-esta-senha-tambem
S3_FORCE_PATH_STYLE=true

# WebRTC — sem TURN, chamadas podem falhar atrás de NAT simétrico ou firewalls corporativos.
# Use o mesmo segredo no coturn (docker-compose passa TURN_SECRET para ele).
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:comunidade.exemplo.com:3478?transport=udp,turn:comunidade.exemplo.com:3478?transport=tcp
TURN_SECRET=gere-com-openssl-rand-hex-32
# IP público do servidor (ajuda o coturn atrás de NAT)
PUBLIC_IP=

# Backups diários do PostgreSQL
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Antivírus opcional para uploads (docker compose --profile antivirus up -d)
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# Bot de IA (opcional; o proprietário também pode cadastrar a chave no painel — fica criptografada)
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5

# Busca de GIFs pelo Tenor (opcional; as buscas passam pelo servidor)
# GIF_PROVIDER_KEY=
