			<Item class="ModuleScript" referent="RBX00000003">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Números de balanceamento do jogo. Este arquivo é replicado para os
-- jogadores (qualquer um pode ler), então nada aqui é secreto, e o servidor
-- nunca confia em valores enviados pelo cliente.

local Config = {
	-- Partida
	MAX_PLAYERS = 4,
	LOBBY_COUNTDOWN = 25, -- segundos no saguão antes de começar
	READY_COUNTDOWN = 4, -- quando todos apertam "Pronto"
	SHOP_DURATION = 20, -- intervalo de loja entre ondas
	GAME_OVER_DURATION = 12,
	BOSS_EVERY = 5, -- chefe a cada N ondas
	MAX_ALIVE_ENEMIES = 28,
	LATE_JOIN_COINS_PER_WAVE = 25, -- moedas para quem entra no meio

	-- Mapa
	ARENA_LIMIT = 190, -- inimigos ficam dentro deste quadrado (±)
	PORTAL_DISTANCE = 150,
	SEAL_POSITION = Vector3.new(0, 7, 0),
	SEAL_RADIUS = 5,
	SEAL_MAX_HEALTH = 1500,
	SEAL_HEAL_FRACTION = 0.3, -- item "Restaurar Selo"

	-- Jogador
	PLAYER_BASE_HEALTH = 100,
	PLAYER_BASE_SPEED = 18,
	ENERGY_MAX = 100,
	ENERGY_REGEN = 9, -- por segundo
	ENERGY_ON_HIT = 2,
	ULT_MAX = 100,
	ULT_PER_DAMAGE = 0.07,
	ULT_PER_KILL = 3,
	RESPAWN_DELAY = 3,
	DASH_INVULNERABILITY = 0.35,

	-- Golpe básico (clique)
	M1_COOLDOWN = 0.36,
	M1_DAMAGE = 14,
	M1_RANGE = 8,
	M1_COMBO_RESET = 1.2,
	M1_FINISHER_MULT = 2,

	-- Recompensas
	WAVE_CLEAR_COINS_BASE = 30,
	WAVE_CLEAR_COINS_PER_WAVE = 6,
	FRAGMENTS_PER_WAVE = 4,
	FRAGMENTS_PER_KILLS = 5, -- 1 fragmento a cada N abates
	FRAGMENTS_PER_BOSS = 15,

	-- Despertar (sorteio de técnica)
	REROLL_COST = 60,
	STARTING_FRAGMENTS = 60,
	PITY_ROLLS = 10, -- épico ou melhor garantido a cada N rolagens

	-- Salvamento
	DATASTORE_NAME = "NoiteMaldita_v1",
	AUTOSAVE_INTERVAL = 90,
}

return table.freeze(Config)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<string name="Name">Enemies</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Maldições (inimigos). Os números são a base da onda 1; o servidor
-- multiplica vida e dano conforme a onda e a quantidade de jogadores.

export type EnemyKind = "melee" | "ranged" | "boss"
export type BossAbility = "slam" | "charge" | "summon" | "volley"

export type EnemyDef = {
	id: string,
	name: string,
	kind: EnemyKind,
	health: number,
	damage: number,
	speed: number,
	size: number,
	attackRange: number,
	attackCooldown: number,
	coins: number,
	color: Color3,
	eyeColor: Color3,
	eyes: number,
	horns: boolean,
	preferredRange: number?,
	projectileSpeed: number?,
	abilities: { BossAbility }?,
	abilityCooldown: number?,
}

local Enemies = {}

Enemies.defs = {
	menor = {
		id = "menor",
		name = "Maldição Menor",
		kind = "melee",
		health = 60,
		damage = 8,
		speed = 14,
		size = 3,
		attackRange = 4.5,
		attackCooldown = 1,
		coins = 5,
		color = Color3.fromRGB(55, 40, 70),
		eyeColor = Color3.fromRGB(255, 60, 60),
		eyes = 2,
		horns = false,
	},
	veloz = {
