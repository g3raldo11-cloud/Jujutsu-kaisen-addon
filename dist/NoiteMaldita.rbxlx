			<Item class="ModuleScript" referent="RBX00000005">
				<Properties>
					<string name="Name">GameState</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Estado público da partida (fase, onda, vida do selo, chefe...).
-- Fica como Attributes numa pasta em ReplicatedStorage: o servidor escreve,
-- os clientes leem e reagem às mudanças.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type Phase = "Lobby" | "Wave" | "Shop" | "GameOver"

local DEFAULTS: { [string]: any } = {
	Phase = "Lobby",
	Wave = 0,
	Countdown = 0,
	EnemiesLeft = 0,
	SealHealth = 1,
	SealMaxHealth = 1,
	BossName = "",
	BossHealth = 0,
	BossMaxHealth = 1,
	ReadyCount = 0,
	PlayerCount = 0,
	BestWave = 0,
}

local folder: Instance
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("GameState")
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name = "GameState"
		for key, value in DEFAULTS do
			created:SetAttribute(key, value)
		end
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("GameState")
end

local GameState = {}

function GameState.get(key: string): any
	local value = folder:GetAttribute(key)
	if value == nil then
		return DEFAULTS[key]
	end
	return value
end

function GameState.set(key: string, value: any)
	folder:SetAttribute(key, value)
end

function GameState.phase(): Phase
	return GameState.get("Phase") :: Phase
end

function GameState.onChanged(key: string, callback: () -> ()): RBXScriptConnection
	return folder:GetAttributeChangedSignal(key):Connect(callback)
end

return GameState
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000006">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Todos os RemoteEvents do jogo, definidos em UM lugar.
-- O servidor cria; o cliente só espera por eles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

export type RemoteName =
	"UseSkill" -- C→S  (slot: number, aim: Vector3)
	| "SkillResult" -- S→C  (slot: number, cooldown: number, extra: {[string]: any}?)
	| "Fx" -- S→C  (kind: string, data: {[string]: any})
	| "BuyUpgrade" -- C→S  (upgradeId: string)
	| "Reroll" -- C→S  ()
	| "RerollResult" -- S→C  (techniqueId: string)
	| "ToggleReady" -- C→S  ()
	| "Announce" -- S→C  (title: string, subtitle: string, color: Color3, duration: number)
	| "Notify" -- S→C  (text: string, color: Color3?)

local NAMES: { RemoteName } = {
	"UseSkill",
	"SkillResult",
	"Fx",
	"BuyUpgrade",
	"Reroll",
	"RerollResult",
	"ToggleReady",
	"Announce",
	"Notify",
}

local IS_SERVER = RunService:IsServer()

local folder: Instance
if IS_SERVER then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name = "Remotes"
		for _, name in NAMES do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = created
		end
		created.Parent = ReplicatedStorage
		folder = created
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

local Net = {}

function Net.event(name: RemoteName): RemoteEvent
	local remote = if IS_SERVER then folder:FindFirstChild(name) else folder:WaitForChild(name)
	assert(remote and remote:IsA("RemoteEvent"), `Remote {name} não encontrado`)
	return remote
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000007">
				<Properties>
					<string name="Name">Techniques</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Técnicas de feitiçaria. Cada jogador desperta UMA técnica (sorteada) que
-- define suas 3 habilidades e o seu Território (golpe especial).
--
-- Slots: 1 = projétil (Z), 2 = explosão em área (X), 3 = investida (C),
--        4 = Território (V), 0 = golpe básico (clique).

export type Effect = "knockback" | "pierce" | "burn" | "slow" | "chain" | "lifesteal" | "pull" | "heal"
export type RarityId = "comum" | "raro" | "epico" | "lendario"
export type SkillKind = "projectile" | "burst" | "dash"

export type SkillDef = {
	name: string,
	kind: SkillKind,
	damage: number,
	cooldown: number,
	cost: number,
	radius: number,
	speed: number?,
	range: number?,
	count: number?,
}

export type DomainDef = {
	name: string,
	radius: number,
	duration: number,
	damage: number, -- por pulso
	tick: number, -- segundos entre pulsos
}

export type Technique = {
	id: string,
	name: string,
	rarity: RarityId,
	description: string,
	effectText: string,
	color: Color3,
	secondary: Color3,
	effect: Effect,
	skills: { SkillDef },
	domain: DomainDef,
}

export type RarityInfo = {
	name: string,
	weight: number,
	rank: number,
	color: Color3,
}

local Techniques = {}

Techniques.RARITY_ORDER = { "comum", "raro", "epico", "lendario" } :: { RarityId }

Techniques.RARITY = {
	comum = { name = "Comum", weight = 50, rank = 1, color = Color3.fromRGB(205, 205, 215) },
	raro = { name = "Raro", weight = 30, rank = 2, color = Color3.fromRGB(80, 165, 255) },
	epico = { name = "Épico", weight = 15, rank = 3, color = Color3.fromRGB(195, 95, 255) },
	lendario = { name = "Lendário", weight = 5, rank = 4, color = Color3.fromRGB(255, 195, 45) },
} :: { [RarityId]: RarityInfo }

Techniques.list = {
	{
		id = "terra",
		name = "Punho de Rocha",
		rarity = "comum",
		description = "Força bruta da terra. Golpes pesados que empurram as maldições para longe.",
		effectText = "Empurra os inimigos",
		color = Color3.fromRGB(170, 120, 75),
		secondary = Color3.fromRGB(255, 205, 130),
		effect = "knockback",
		skills = {
			{ name = "Rocha Arremessada", kind = "projectile", damage = 32, cooldown = 2.4, cost = 15, radius = 4, speed = 85, range = 95 },
			{ name = "Tremor", kind = "burst", damage = 36, cooldown = 6, cost = 25, radius = 15 },
			{ name = "Investida Rochosa", kind = "dash", damage = 30, cooldown = 5, cost = 18, radius = 6, range = 22 },
		},
		domain = { name = "Território: Vale de Pedra", radius = 32, duration = 8, damage = 20, tick = 0.5 },
	},
	{
		id = "vento",
		name = "Lâmina do Vento",
		rarity = "comum",
		description = "Cortes rápidos que atravessam fileiras de inimigos.",
		effectText = "Projéteis atravessam",
		color = Color3.fromRGB(150, 240, 210),
		secondary = Color3.fromRGB(255, 255, 255),
		effect = "pierce",
		skills = {
			{ name = "Corte Crescente", kind = "projectile", damage = 18, cooldown = 2, cost = 15, radius = 3, speed = 135, range = 110, count = 3 },
			{ name = "Ciclone", kind = "burst", damage = 26, cooldown = 5.5, cost = 22, radius = 16 },
			{ name = "Passo do Vendaval", kind = "dash", damage = 24, cooldown = 3.5, cost = 14, radius = 6, range = 34 },
		},
		domain = { name = "Território: Céu Cortante", radius = 34, duration = 8, damage = 17, tick = 0.4 },
	},
	{
		id = "fogo",
		name = "Chama Carmesim",
		rarity = "raro",
		description = "Fogo amaldiçoado que continua queimando depois do golpe.",
		effectText = "Queimadura (dano contínuo)",
		color = Color3.fromRGB(255, 75, 40),
		secondary = Color3.fromRGB(255, 195, 60),
		effect = "burn",
		skills = {
			{ name = "Bola de Fogo", kind = "projectile", damage = 34, cooldown = 2.4, cost = 16, radius = 6, speed = 90, range = 100 },
			{ name = "Erupção", kind = "burst", damage = 40, cooldown = 6, cost = 26, radius = 16 },
			{ name = "Rastro Flamejante", kind = "dash", damage = 32, cooldown = 4.5, cost = 18, radius = 7, range = 26 },
		},
		domain = { name = "Território: Fornalha Rubra", radius = 32, duration = 8, damage = 24, tick = 0.5 },
	},
	{
		id = "gelo",
		name = "Geada Eterna",
		rarity = "raro",
		description = "O frio que paralisa. Maldições congeladas mal conseguem andar.",
		effectText = "Deixa os inimigos lentos",
		color = Color3.fromRGB(125, 205, 255),
		secondary = Color3.fromRGB(235, 250, 255),
		effect = "slow",
		skills = {
			{ name = "Lança de Gelo", kind = "projectile", damage = 34, cooldown = 2.2, cost = 15, radius = 4, speed = 120, range = 110 },
			{ name = "Inverno Súbito", kind = "burst", damage = 32, cooldown = 6, cost = 24, radius = 19 },
			{ name = "Deslize Glacial", kind = "dash", damage = 30, cooldown = 4, cost = 16, radius = 7, range = 28 },
		},
		domain = { name = "Território: Tundra Silenciosa", radius = 36, duration = 8, damage = 22, tick = 0.5 },
	},
	{
		id = "trovao",
		name = "Trovão Celeste",
		rarity = "epico",
		description = "Relâmpagos que saltam de um inimigo para o outro.",
		effectText = "Dano salta para inimigos próximos",
		color = Color3.fromRGB(255, 230, 80),
		secondary = Color3.fromRGB(150, 190, 255),
		effect = "chain",
		skills = {
			{ name = "Raio Saltitante", kind = "projectile", damage = 40, cooldown = 2.2, cost = 16, radius = 4, speed = 170, range = 120 },
			{ name = "Tempestade", kind = "burst", damage = 46, cooldown = 6, cost = 26, radius = 17 },
			{ name = "Passo Relâmpago", kind = "dash", damage = 38, cooldown = 3.5, cost = 16, radius = 7, range = 32 },
		},
		domain = { name = "Território: Coroa de Trovões", radius = 34, duration = 8, damage = 28, tick = 0.5 },
	},
	{
		id = "sombra",
		name = "Sombra Faminta",
		rarity = "epico",
		description = "As sombras devoram as maldições e devolvem vida a você.",
		effectText = "Rouba vida",
		color = Color3.fromRGB(95, 45, 150),
		secondary = Color3.fromRGB(255, 70, 140),
		effect = "lifesteal",
		skills = {
			{ name = "Garra Sombria", kind = "projectile", damage = 42, cooldown = 2.3, cost = 16, radius = 5, speed = 110, range = 100 },
			{ name = "Boca do Abismo", kind = "burst", damage = 48, cooldown = 6, cost = 26, radius = 16 },
			{ name = "Passo Fantasma", kind = "dash", damage = 40, cooldown = 3.8, cost = 16, radius = 7, range = 30 },
		},
		domain = { name = "Território: Banquete das Sombras", radius = 34, duration = 8, damage = 28, tick = 0.5 },
	},
	{
		id = "vazio",
		name = "Vazio Estelar",
		rarity = "lendario",
		description = "Dobra o espaço. Puxa tudo para o centro e esmaga.",
		effectText = "Puxa os inimigos",
		color = Color3.fromRGB(60, 30, 130),
		secondary = Color3.fromRGB(175, 130, 255),
		effect = "pull",
		skills = {
			{ name = "Esfera do Vazio", kind = "projectile", damage = 52, cooldown = 2.6, cost = 18, radius = 8, speed = 75, range = 100 },
			{ name = "Colapso", kind = "burst", damage = 58, cooldown = 6, cost = 28, radius = 21 },
			{ name = "Dobra Espacial", kind = "dash", damage = 46, cooldown = 3.5, cost = 16, radius = 8, range = 36 },
		},
		domain = { name = "Território: Horizonte Infinito", radius = 38, duration = 9, damage = 34, tick = 0.5 },
	},
	{
		id = "sol",
		name = "Coração do Sol",
		rarity = "lendario",
		description = "Luz que queima maldições e cura os aliados.",
		effectText = "Cura você e os aliados",
		color = Color3.fromRGB(255, 200, 60),
		secondary = Color3.fromRGB(255, 255, 210),
		effect = "heal",
		skills = {
			{ name = "Lança Solar", kind = "projectile", damage = 50, cooldown = 2.2, cost = 16, radius = 5, speed = 160, range = 120 },
			{ name = "Aurora", kind = "burst", damage = 52, cooldown = 6, cost = 26, radius = 19 },
			{ name = "Cometa", kind = "dash", damage = 46, cooldown = 3.8, cost = 16, radius = 8, range = 32 },
		},
		domain = { name = "Território: Meio-Dia Eterno", radius = 36, duration = 9, damage = 30, tick = 0.5 },
	},
} :: { Technique }

Techniques.byId = {} :: { [string]: Technique }
for _, technique in Techniques.list do
	Techniques.byId[technique.id] = technique
end

-- Sorteia uma técnica. `minRank` > 1 garante raridade mínima (sistema de "pena").
function Techniques.roll(rng: Random, minRank: number): Technique
	local total = 0
	for _, rarityId in Techniques.RARITY_ORDER do
		local info = Techniques.RARITY[rarityId]
		if info.rank >= minRank then
			total += info.weight
		end
	end

	local pick = rng:NextNumber() * total
	local chosen: RarityId = "lendario"
	for _, rarityId in Techniques.RARITY_ORDER do
		local info = Techniques.RARITY[rarityId]
		if info.rank >= minRank then
			chosen = rarityId
			pick -= info.weight
			if pick <= 0 then
				break
			end
		end
	end

	local pool: { Technique } = {}
	for _, technique in Techniques.list do
		if technique.rarity == chosen then
			table.insert(pool, technique)
		end
	end
	return pool[rng:NextInteger(1, #pool)]
end

return Techniques
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000008">
				<Properties>
					<string name="Name">Upgrades</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Itens da loja entre ondas. Custos e efeitos são calculados no servidor;
-- o cliente usa a mesma tabela só para mostrar preços.

export type Upgrade = {
	id: string,
	name: string,
	description: string,
	baseCost: number,
	costGrowth: number,
	maxLevel: number,
	perLevel: number,
	team: boolean?,
}

local Upgrades = {}

Upgrades.list = {
	{
		id = "vida",
		name = "Vigor",
		description = "+25 de vida máxima",
		baseCost = 40,
		costGrowth = 1.45,
		maxLevel = 10,
		perLevel = 25,
	},
	{
		id = "dano",
		name = "Fúria",
		description = "+15% de dano em tudo",
		baseCost = 50,
		costGrowth = 1.5,
		maxLevel = 12,
		perLevel = 0.15,
	},
	{
		id = "energia",
		name = "Fluxo Amaldiçoado",
		description = "+20% de regeneração de energia",
		baseCost = 40,
		costGrowth = 1.5,
		maxLevel = 8,
		perLevel = 0.2,
	},
	{
		id = "recarga",
		name = "Foco",
		description = "-6% no tempo de recarga",
		baseCost = 55,
		costGrowth = 1.55,
		maxLevel = 6,
		perLevel = 0.06,
	},
	{
		id = "velocidade",
		name = "Passos Leves",
		description = "+1,5 de velocidade",
		baseCost = 35,
		costGrowth = 1.45,
		maxLevel = 6,
		perLevel = 1.5,
	},
	{
		id = "selo",
		name = "Restaurar Selo",
		description = "Cura 30% do Selo Sagrado (ajuda o time todo)",
		baseCost = 60,
		costGrowth = 1.3,
		maxLevel = 99,
		perLevel = 0,
		team = true,
	},
} :: { Upgrade }

Upgrades.byId = {} :: { [string]: Upgrade }
for _, upgrade in Upgrades.list do
	Upgrades.byId[upgrade.id] = upgrade
end

function Upgrades.cost(upgrade: Upgrade, level: number): number
	return math.floor(upgrade.baseCost * upgrade.costGrowth ^ level)
end

return Upgrades
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX00000009">
				<Properties>
					<string name="Name">Util</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX0000000A">
					<Properties>
						<string name="Name">Arena</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Geometria do mapa usada pelos dois lados (servidor e cliente).
-- O templo central tem 3 degraus; as maldições "flutuam" na altura do chão.

local Arena = {}

-- Degraus do templo: metade do lado do quadrado e altura do topo.
Arena.TIERS = {
	{ half = 35, top = 1 },
	{ half = 28, top = 2 },
	{ half = 17, top = 3 },
}

function Arena.groundHeight(position: Vector3): number
	local distance = math.max(math.abs(position.X), math.abs(position.Z))
	local height = 0
	for _, tier in Arena.TIERS do
		if distance <= tier.half then
			height = tier.top
		end
	end
	return height
end

function Arena.flat(vector: Vector3): Vector3
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Distância ignorando a altura (o mundo é praticamente plano).
function Arena.flatDistance(a: Vector3, b: Vector3): number
	local dx = a.X - b.X
	local dz = a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Distância horizontal de um ponto até um segmento (para investidas).
function Arena.distanceToSegment(point: Vector3, a: Vector3, b: Vector3): number
	local p = Arena.flat(point)
	local fa = Arena.flat(a)
	local fb = Arena.flat(b)
	local ab = fb - fa
	local lengthSq = ab:Dot(ab)
	if lengthSq < 1e-6 then
		return (p - fa).Magnitude
	end
	local t = math.clamp((p - fa):Dot(ab) / lengthSq, 0, 1)
	return (p - (fa + ab * t)).Magnitude
end

return Arena
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000000B">
					<Properties>
						<string name="Name">Signal</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Sinal simples para eventos entre módulos (sem usar _G).

export type Signal = {
	Connect: (self: Signal, callback: (...any) -> ()) -> () -> (),
	Fire: (self: Signal, ...any) -> (),
}

local Signal = {}

function Signal.new(): Signal
	local handlers: { (...any) -> () } = {}
	local signal = {}

	function signal.Connect(_self: Signal, callback: (...any) -> ()): () -> ()
		table.insert(handlers, callback)
		return function()
			local index = table.find(handlers, callback)
			if index then
				table.remove(handlers, index)
			end
		end
	end

	function signal.Fire(_self: Signal, ...: any)
		for _, handler in table.clone(handlers) do
			task.spawn(handler, ...)
		end
	end

	return (signal :: any) :: Signal
end

return Signal
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX0000000C">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX0000000D">
			<Properties>
				<string name="Name">Server</string>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Noite Maldita — ponto de entrada do servidor.
-- Carrega todos os sistemas em duas fases: init() de todos, depois start().

local Systems = script:WaitForChild("Systems")

-- Ordem explícita: o mapa e os dados vêm antes de quem depende deles.
local ORDER = {
	"MapBuilder",
	"PlayerData",
	"CharacterService",
	"EnemyService",
	"CombatService",
	"WaveService",
	"ShopService",
	"AwakenService",
}

local loaded: { { name: string, system: any } } = {}
local seen: { [string]: boolean } = {}

local function load(module: Instance)
	if module:IsA("ModuleScript") and not seen[module.Name] then
		seen[module.Name] = true
		table.insert(loaded, { name = module.Name, system = require(module) :: any })
	end
end

for _, name in ORDER do
	local module = Systems:FindFirstChild(name)
	if module then
		load(module)
	else
		warn(`[NoiteMaldita] sistema {name} não encontrado`)
	end
end
for _, module in Systems:GetChildren() do
	load(module)
end

for _, entry in loaded do
	if typeof(entry.system.init) == "function" then
		entry.system.init()
	end
end

for _, entry in loaded do
	if typeof(entry.system.start) == "function" then
		task.spawn(entry.system.start)
	end
end

print("[NoiteMaldita] servidor iniciado")
]]></ProtectedString>
			</Properties>
			<Item class="Folder" referent="RBX0000000E">
				<Properties>
					<string name="Name">Systems</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX0000000F">
					<Properties>
						<string name="Name">AwakenService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Despertar: sorteio da técnica de feitiçaria.
-- A primeira técnica é grátis. Trocar custa fragmentos (ganhos jogando).
-- "Pena": a cada PITY_ROLLS rolagens sem Épico/Lendário, o próximo é garantido.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Techniques = require(Shared:WaitForChild("Techniques"))

local Util = script.Parent.Parent:WaitForChild("Util")
local RateLimit = require(Util:WaitForChild("RateLimit"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local AwakenService = {}

local rng = Random.new()

local function roll(profile: any): any
	local guaranteed = profile.rollsSinceEpic >= Config.PITY_ROLLS - 1
	local technique = Techniques.roll(rng, if guaranteed then 3 else 1)
	if Techniques.RARITY[technique.rarity].rank >= 3 then
		profile.rollsSinceEpic = 0
	else
		profile.rollsSinceEpic += 1
	end
	return technique
end

local function onReroll(player: Player)
	if not RateLimit.allow(player, "Reroll", 1, 2) then
		return
	end
	local phase = GameState.phase()
	if phase ~= "Lobby" and phase ~= "GameOver" then
		Net.event("Notify"):FireClient(player, "Só dá para despertar uma nova técnica no saguão.", Color3.fromRGB(255, 200, 120))
		return
	end
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	if profile.fragments < Config.REROLL_COST then
		Net.event("Notify"):FireClient(player, "Fragmentos insuficientes. Jogue partidas para ganhar mais!", Color3.fromRGB(255, 110, 110))
		return
	end

	profile.fragments -= Config.REROLL_COST
	local technique = roll(profile)
	profile.technique = technique.id
	PlayerData.sync(player)
	Net.event("RerollResult"):FireClient(player, technique.id)

	if technique.rarity == "lendario" then
		-- Espera a animação do sorteio terminar antes de contar para todos.
		task.delay(2.2, function()
			Net.event("Announce"):FireAllClients(
				"DESPERTAR LENDÁRIO",
				`{player.DisplayName} despertou {technique.name}!`,
				Techniques.RARITY.lendario.color,
				3
			)
		end)
	end
end

local function ensureTechnique(player: Player, profile: any)
	if not Techniques.byId[profile.technique] then
		-- Primeira vez: técnica grátis.
		profile.technique = roll(profile).id
		PlayerData.sync(player)
		player:SetAttribute("FirstAwaken", true)
	end
end

function AwakenService.start()
	PlayerData.Loaded:Connect(ensureTechnique)
	-- Jogadores que carregaram antes deste sistema começar.
	for _, player in Players:GetPlayers() do
		local profile = PlayerData.get(player)
		if profile then
			ensureTechnique(player, profile)
		end
	end
	Net.event("Reroll").OnServerEvent:Connect(onReroll)
end

return AwakenService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">CharacterService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Personagens dos jogadores: aparecer no templo, aplicar melhorias
-- (vida, velocidade), brilho da técnica e regras de reviver.
-- Durante uma onda, quem morre só volta quando a onda termina.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local Techniques = require(Shared:WaitForChild("Techniques"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Run = require(Util:WaitForChild("Run"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local CharacterService = {}
CharacterService.Died = Signal.new() -- (player)

local spawning: { [Player]: boolean } = {}

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid
end

function CharacterService.getRoot(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function CharacterService.isAlive(player: Player): boolean
	local humanoid = getHumanoid(player)
	return humanoid ~= nil and humanoid.Health > 0 and CharacterService.getRoot(player) ~= nil
end

function CharacterService.getHumanoid(player: Player): Humanoid?
	return getHumanoid(player)
end

function CharacterService.aliveInMatch(): number
	local count = 0
	for _, player in Players:GetPlayers() do
		local run = Run.get(player)
		if run and run.inMatch and CharacterService.isAlive(player) then
			count += 1
		end
	end
	return count
end

-- Brilho na cor da técnica (fica bonito à noite).
local function applyAura(player: Player)
	local root = CharacterService.getRoot(player)
	if not root then
		return
	end
	local technique = Techniques.byId[player:GetAttribute("Technique") :: string? or ""]
	local color = if technique then technique.color else Color3.fromRGB(200, 200, 255)
	local light = root:FindFirstChild("AuraLight")
	if not light then
		local created = Instance.new("PointLight")
		created.Name = "AuraLight"
		created.Range = 12
		created.Brightness = 1.2
		created.Shadows = false
		created.Parent = root
		light = created
	end
	(light :: PointLight).Color = color
end

function CharacterService.applyStats(player: Player)
	local humanoid = getHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local newMax = Run.maxHealth(player)
	local gained = newMax - humanoid.MaxHealth
	humanoid.MaxHealth = newMax
	if gained > 0 then
		humanoid.Health = math.min(newMax, humanoid.Health + gained)
	end
	humanoid.WalkSpeed = Run.walkSpeed(player)
	applyAura(player)
end

function CharacterService.heal(player: Player, amount: number)
	local humanoid = getHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

function CharacterService.healFull(player: Player)
	local humanoid = getHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = humanoid.MaxHealth
	end
end

function CharacterService.spawn(player: Player)
	if spawning[player] or not player.Parent then
		return
	end
	spawning[player] = true
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	spawning[player] = nil
	if not ok then
		warn(`[CharacterService] falha ao criar personagem de {player.Name}: {err}`)
	end
end

function CharacterService.respawnDead()
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("DataLoaded") and not CharacterService.isAlive(player) then
			task.spawn(CharacterService.spawn, player)
		end
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end
	humanoid.MaxHealth = Run.maxHealth(player)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = Run.walkSpeed(player)
	character:WaitForChild("HumanoidRootPart", 10)
	applyAura(player)

	humanoid.Died:Connect(function()
		CharacterService.Died:Fire(player)
		local phase = GameState.phase()
		local run = Run.get(player)
		if phase == "Wave" and run and run.inMatch then
			Net.event("Notify"):FireAllClients(`{player.DisplayName} caiu! Volta no fim da onda.`, Color3.fromRGB(255, 110, 110))
			return
		end
		task.wait(Config.RESPAWN_DELAY)
		if player.Parent and GameState.phase() ~= "Wave" and not CharacterService.isAlive(player) then
			CharacterService.spawn(player)
		end
	end)
end

local function onPlayerAdded(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local kills = Instance.new("IntValue")
	kills.Name = "Abates"
	kills.Parent = leaderstats
	local best = Instance.new("IntValue")
	best.Name = "Recorde"
	best.Parent = leaderstats
	leaderstats.Parent = player

	Run.ensure(player)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local profile = PlayerData.waitFor(player)
	if not profile or not player.Parent then
		return
	end
	PlayerData.sync(player)

	-- Entra num jogo em andamento? Ganha moedas para alcançar o time.
	local phase = GameState.phase()
	if phase == "Wave" or phase == "Shop" then
		Run.setInMatch(player, true)
		Run.addCoins(player, Config.LATE_JOIN_COINS_PER_WAVE * (GameState.get("Wave") :: number))
	end

	if phase ~= "Wave" then
		CharacterService.spawn(player)
	else
		Net.event("Notify"):FireClient(player, "Uma onda está acontecendo. Você entra quando ela acabar!", Color3.fromRGB(255, 220, 120))
	end
end

function CharacterService.init()
	Players.CharacterAutoLoads = false
end

function CharacterService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- A técnica mudou (Despertar)? Atualiza o brilho.
	local function watchTechnique(player: Player)
		player:GetAttributeChangedSignal("Technique"):Connect(function()
			applyAura(player)
		end)
	end
	Players.PlayerAdded:Connect(watchTechnique)
	for _, player in Players:GetPlayers() do
		watchTechnique(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		spawning[player] = nil
	end)
end

return CharacterService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000011">
					<Properties>
						<string name="Name">CombatService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Combate dos jogadores: golpe básico em combo, as 3 habilidades da técnica,
-- o Território (golpe especial), energia e carga do especial.
-- O cliente só PEDE ("usei o slot 2 mirando aqui"); o servidor confere
-- recarga, energia e distância, e calcula todo o dano.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))
local Techniques = require(Shared:WaitForChild("Techniques"))
local Arena = require(Shared:WaitForChild("Util"):WaitForChild("Arena"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Guard = require(Util:WaitForChild("Guard"))
local RateLimit = require(Util:WaitForChild("RateLimit"))
local Run = require(Util:WaitForChild("Run"))
local CharacterService = require(script.Parent:WaitForChild("CharacterService"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))

type Enemy = any -- registro de inimigo (ver EnemyService.Enemy)

type HitOptions = {
	chained: boolean?,
	noEffect: boolean?,
	origin: Vector3?,
	crit: boolean?,
}

type Projectile = {
	id: number,
	owner: Player,
	technique: any,
	position: Vector3,
	direction: Vector3,
	speed: number,
	remaining: number,
	radius: number,
	damage: number,
	pierce: boolean,
	hit: { [Enemy]: boolean },
}

type Domain = {
	owner: Player,
	technique: any,
	center: Vector3,
	radius: number,
	endsAt: number,
	nextTick: number,
}

local CombatService = {}

local cooldowns: { [Player]: { [number]: number } } = {}
local combo: { [Player]: { count: number, last: number } } = {}
local projectiles: { Projectile } = {}
local domains: { Domain } = {}
local nextProjectileId = 0

local MAX_AIM_DISTANCE = 600

local function fxAll(kind: string, data: { [string]: any })
	Net.event("Fx"):FireAllClients(kind, data)
end

local function fxTo(player: Player, kind: string, data: { [string]: any })
	Net.event("Fx"):FireClient(player, kind, data)
end

local function techniqueOf(player: Player): any
	local id = player:GetAttribute("Technique")
	return if typeof(id) == "string" then Techniques.byId[id] else nil
end

----------------------------------------------------------------------------
-- Aplicar dano (todo dano de jogador passa por aqui)
----------------------------------------------------------------------------

local applyHit: (player: Player, enemy: Enemy, baseDamage: number, technique: any, options: HitOptions?) -> ()

function applyHit(player: Player, enemy: Enemy, baseDamage: number, technique: any, options: HitOptions?)
	if not enemy.alive then
		return
	end
	local opts: HitOptions = options or {}
	local crit = opts.crit == true or math.random() < 0.08
	local amount = baseDamage * Run.damageMultiplier(player) * (if crit then 1.5 else 1)
	local position = enemy.root.Position
	local dealt = EnemyService.damage(enemy, amount, player)
	if dealt <= 0 then
		return
	end

	local run = Run.get(player)
	if run then
		run.damageDealt += dealt
		Run.setEnergy(player, run.energy + Config.ENERGY_ON_HIT)
		if not run.domainActive then
			Run.setUlt(player, run.ult + dealt * Config.ULT_PER_DAMAGE)
		end
	end

	fxTo(player, "dmg", {
		position = position + Vector3.new(0, enemy.def.size * 0.6, 0),
		amount = dealt,
		color = if crit then Color3.fromRGB(255, 230, 80) else Color3.new(1, 1, 1),
		crit = crit,
	})

	if opts.noEffect or not technique then
		return
	end

	local effect = technique.effect
	local origin = opts.origin or position
	if effect == "knockback" then
		EnemyService.knockback(enemy, origin, 7)
	elseif effect == "burn" then
		EnemyService.addBurn(enemy, dealt * 0.22, 4, player)
	elseif effect == "slow" then
		EnemyService.addSlow(enemy, 0.45, 2.5)
	elseif effect == "chain" and not opts.chained then
		local exclude: { [Enemy]: boolean } = { [enemy] = true }
		local from = position
		for _ = 1, 2 do
			local nextEnemy = EnemyService.nearest(from, 20, exclude)
			if not nextEnemy then
				break
			end
			exclude[nextEnemy] = true
			local to = nextEnemy.root.Position
			fxAll("chain", { from = from, to = to, color = technique.color })
			applyHit(player, nextEnemy, baseDamage * 0.6, technique, { chained = true })
			from = to
		end
	elseif effect == "lifesteal" then
		CharacterService.heal(player, dealt * 0.15)
	elseif effect == "pull" then
		EnemyService.knockback(enemy, origin, -5)
	end
end

local function healAllies(center: Vector3, radius: number, amount: number)
	for _, ally in Players:GetPlayers() do
		local root = CharacterService.getRoot(ally)
		if root and CharacterService.isAlive(ally) and Arena.flatDistance(root.Position, center) <= radius then
			CharacterService.heal(ally, amount)
			fxAll("heal", { position = root.Position, amount = amount })
		end
	end
end

----------------------------------------------------------------------------
-- Habilidades
----------------------------------------------------------------------------

local function doBasicAttack(player: Player, root: BasePart, direction: Vector3, technique: any)
	local now = os.clock()
	local state = combo[player]
	if not state or now - state.last > Config.M1_COMBO_RESET then
		state = { count = 0, last = now }
		combo[player] = state
	end
	local current = state :: { count: number, last: number }
	current.count = current.count % 4 + 1
	current.last = now
	local finisher = current.count == 4

	local damage = Config.M1_DAMAGE * (if finisher then Config.M1_FINISHER_MULT else 1)
	local range = Config.M1_RANGE + (if finisher then 2 else 0)
	local origin = root.Position
	local color = if technique then technique.color else Color3.new(1, 1, 1)

	for _, enemy in EnemyService.inRadius(origin, range) do
		local toEnemy = Arena.flat(enemy.position - origin)
		local facing = if toEnemy.Magnitude > 0.1 then toEnemy.Unit:Dot(direction) else 1
		if facing > 0.2 then
			applyHit(player, enemy, damage, technique, { noEffect = not finisher, origin = origin })
			if finisher then
				EnemyService.knockback(enemy, origin, 6)
			end
		end
	end

	fxAll("m1", { position = origin, direction = direction, color = color, finisher = finisher, combo = current.count })
end

local function fireProjectile(player: Player, root: BasePart, direction: Vector3, skill: any, technique: any)
	local count = skill.count or 1
	local spread = math.rad(12)
	for i = 1, count do
		local angle = (i - (count + 1) / 2) * spread
		local dir = (CFrame.Angles(0, angle, 0) * CFrame.new(Vector3.zero, direction)).LookVector
		dir = Arena.flat(dir).Unit
		nextProjectileId += 1
		local origin = root.Position + dir * 2.5
		local projectile: Projectile = {
			id = nextProjectileId,
			owner = player,
			technique = technique,
			position = origin,
			direction = dir,
			speed = skill.speed or 100,
			remaining = skill.range or 100,
			radius = skill.radius,
			damage = skill.damage,
			pierce = technique.effect == "pierce",
			hit = {},
		}
		table.insert(projectiles, projectile)
		fxAll("proj", {
			id = projectile.id,
			origin = origin,
			direction = dir,
			speed = projectile.speed,
			range = projectile.remaining,
			radius = projectile.radius,
			color = technique.color,
			color2 = technique.secondary,
			tech = technique.id,
		})
	end
end

local function doBurst(player: Player, root: BasePart, skill: any, technique: any)
	local center = root.Position
	for _, enemy in EnemyService.inRadius(center, skill.radius) do
		applyHit(player, enemy, skill.damage, technique, { origin = center })
	end
	if technique.effect == "heal" then
		healAllies(center, skill.radius + 6, 25)
	end
	fxAll("burst", {
		position = center,
		radius = skill.radius,
		color = technique.color,
		color2 = technique.secondary,
		tech = technique.id,
	})
end

local function doDash(player: Player, root: BasePart, direction: Vector3, skill: any, technique: any): Vector3
	local from = root.Position
	local range: number = skill.range or 25
	local to = from + direction * range
	local limit = Config.ARENA_LIMIT
	to = Vector3.new(math.clamp(to.X, -limit, limit), from.Y, math.clamp(to.Z, -limit, limit))
	for _, enemy in EnemyService.inSegment(from, to, skill.radius) do
		applyHit(player, enemy, skill.damage, technique, { origin = from })
	end
	local run = Run.get(player)
	if run then
		run.invulnerableUntil = os.clock() + Config.DASH_INVULNERABILITY
	end
	fxAll("dash", { from = from, to = to, color = technique.color, color2 = technique.secondary })
	return to - from
end

local function doDomain(player: Player, root: BasePart, technique: any)
	local domain = technique.domain
	local run = Run.get(player)
	if run then
		run.domainActive = true
	end
	local center = Vector3.new(root.Position.X, 0, root.Position.Z)
	table.insert(domains, {
		owner = player,
		technique = technique,
		center = center,
		radius = domain.radius,
		endsAt = os.clock() + domain.duration,
		nextTick = os.clock() + 0.3,
	})
	fxAll("domain", {
		position = center,
		radius = domain.radius,
		duration = domain.duration,
		color = technique.color,
		color2 = technique.secondary,
		name = domain.name,
		owner = player.DisplayName,
		tech = technique.id,
	})
	local subtitle = `{player.DisplayName} expandiu o Território!`
	Net.event("Announce"):FireAllClients(domain.name, subtitle, technique.color, 2.4)
end

----------------------------------------------------------------------------
-- Pedido do cliente
----------------------------------------------------------------------------

local function onUseSkill(player: Player, slot: unknown, aim: unknown)
	if not RateLimit.allow(player, "UseSkill", 12, 14) then
		return
	end
	if not Guard.integerInRange(slot, 0, 4) or not Guard.vector3(aim) then
		return
	end
	local slotNumber = slot :: number
	local aimPoint = aim :: Vector3

	if not CharacterService.isAlive(player) then
		return
	end
	local root = CharacterService.getRoot(player)
	local run = Run.get(player)
	local technique = techniqueOf(player)
	if not root or not run or not technique then
		return
	end

	-- Direção da mira (plana). Mira absurda = usa para onde o personagem olha.
	local offset = Arena.flat(aimPoint - root.Position)
	local direction: Vector3
	if offset.Magnitude > 0.5 and offset.Magnitude < MAX_AIM_DISTANCE then
		direction = offset.Unit
	else
		local look = Arena.flat(root.CFrame.LookVector)
		direction = if look.Magnitude > 0.01 then look.Unit else Vector3.new(0, 0, -1)
	end

	local now = os.clock()
	local playerCooldowns = cooldowns[player]
	if not playerCooldowns then
		playerCooldowns = {}
		cooldowns[player] = playerCooldowns
	end
	local readyAt = playerCooldowns[slotNumber] or 0
	if now < readyAt - 0.08 then -- pequena folga para a latência
		return
	end

	if slotNumber == 0 then
		playerCooldowns[0] = now + Config.M1_COOLDOWN
		doBasicAttack(player, root, direction, technique)
		return
	end

	if slotNumber == 4 then
		if run.ult < Config.ULT_MAX or run.domainActive then
			Net.event("Notify"):FireClient(player, "O Território ainda não está carregado.", Color3.fromRGB(255, 200, 120))
			return
		end
		Run.setUlt(player, 0)
		playerCooldowns[4] = now + technique.domain.duration
		doDomain(player, root, technique)
		Net.event("SkillResult"):FireClient(player, 4, technique.domain.duration, nil)
		return
	end

	local skill = technique.skills[slotNumber]
	if not skill then
		return
	end
	if run.energy < skill.cost then
		Net.event("Notify"):FireClient(player, "Energia amaldiçoada insuficiente!", Color3.fromRGB(120, 170, 255))
		return
	end
	Run.setEnergy(player, run.energy - skill.cost)
	local cooldown = skill.cooldown * Run.cooldownMultiplier(player)
	playerCooldowns[slotNumber] = now + cooldown

	local extra: { [string]: any }? = nil
	if skill.kind == "projectile" then
		fireProjectile(player, root, direction, skill, technique)
	elseif skill.kind == "burst" then
		doBurst(player, root, skill, technique)
	elseif skill.kind == "dash" then
		local movement = doDash(player, root, direction, skill, technique)
		extra = { dash = movement }
	end
	Net.event("SkillResult"):FireClient(player, slotNumber, cooldown, extra)
end

----------------------------------------------------------------------------
-- Simulação por frame
----------------------------------------------------------------------------

local function stepProjectiles(dt: number)
	for index = #projectiles, 1, -1 do
		local projectile = projectiles[index]
		local travel = projectile.speed * dt
		projectile.position += projectile.direction * travel
		projectile.remaining -= travel

		local finished = projectile.remaining <= 0 or not projectile.owner.Parent
		if not finished then
			for _, enemy in EnemyService.inRadius(projectile.position, projectile.radius * 0.5 + 1) do
				if not projectile.hit[enemy] then
					projectile.hit[enemy] = true
					applyHit(projectile.owner, enemy, projectile.damage, projectile.technique, { origin = projectile.position })
					if not projectile.pierce then
						finished = true
						break
					end
				end
			end
		end

		if finished then
			table.remove(projectiles, index)
			fxAll("projEnd", {
				id = projectile.id,
				position = projectile.position,
				radius = projectile.radius,
				color = projectile.technique.color,
			})
		end
	end
end

local function stepDomains()
	local now = os.clock()
	for index = #domains, 1, -1 do
		local domain = domains[index]
		local owner = domain.owner
		if now >= domain.endsAt or not owner.Parent then
			table.remove(domains, index)
			local run = Run.get(owner)
			if run then
				run.domainActive = false
			end
			fxAll("domainEnd", { position = domain.center })
		elseif now >= domain.nextTick then
			local technique = domain.technique
			domain.nextTick = now + technique.domain.tick
			for _, enemy in EnemyService.inRadius(domain.center, domain.radius) do
				applyHit(owner, enemy, technique.domain.damage, technique, {
					chained = true, -- sem raios em cadeia a cada pulso (seria efeito demais)
					origin = domain.center,
				})
			end
			-- Aliados dentro do Território recuperam energia (e vida, no Sol).
			for _, ally in Players:GetPlayers() do
				local root = CharacterService.getRoot(ally)
				if root and Arena.flatDistance(root.Position, domain.center) <= domain.radius then
					local allyRun = Run.get(ally)
					if allyRun then
						Run.setEnergy(ally, allyRun.energy + 3)
					end
					if technique.effect == "heal" then
						CharacterService.heal(ally, 4)
					end
				end
			end
		end
	end
end

local energyAccumulator = 0
local function stepEnergy(dt: number)
	energyAccumulator += dt
	if energyAccumulator < 0.2 then
		return
	end
	local elapsed = energyAccumulator
	energyAccumulator = 0
	for player, run in Run.all() do
		if run.energy < Config.ENERGY_MAX and CharacterService.isAlive(player) then
			Run.setEnergy(player, run.energy + Config.ENERGY_REGEN * Run.energyRegenMultiplier(player) * elapsed)
		end
	end
end

function CombatService.resetPlayer(player: Player)
	cooldowns[player] = nil
	combo[player] = nil
end

function CombatService.clearAll()
	table.clear(projectiles)
	for _, domain in domains do
		local run = Run.get(domain.owner)
		if run then
			run.domainActive = false
		end
	end
	table.clear(domains)
	table.clear(cooldowns)
end

function CombatService.start()
	Net.event("UseSkill").OnServerEvent:Connect(onUseSkill)

	EnemyService.Killed:Connect(function(enemy: Enemy, killer: Player?)
		if killer and killer.Parent then
			local run = Run.get(killer)
			if run then
				Run.setUlt(killer, run.ult + Config.ULT_PER_KILL)
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		stepProjectiles(dt)
		stepDomains()
		stepEnergy(dt)
	end)

	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		combo[player] = nil
	end)
end

return CombatService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000012">
					<Properties>
						<string name="Name">EnemyService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Maldições: criação dos modelos, inteligência (perseguir jogador ou selo),
-- ataques, projéteis inimigos, habilidades dos chefes e efeitos de status.
-- Toda a lógica roda no servidor; os clientes só desenham os efeitos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Enemies = require(Shared:WaitForChild("Enemies"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Arena = require(Shared:WaitForChild("Util"):WaitForChild("Arena"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Run = require(Util:WaitForChild("Run"))

type Target = { player: Player, humanoid: Humanoid, root: BasePart }

export type Enemy = {
	id: number,
	def: any,
	model: Model,
	root: BasePart,
	alive: boolean,
	isBoss: boolean,
	health: number,
	maxHealth: number,
	damage: number,
	hpMult: number,
	dmgMult: number,
	position: Vector3,
	facing: Vector3,
	knock: Vector3,
	spawnedAt: number,
	nextAttack: number,
	retargetAt: number,
	target: Target?,
	slowUntil: number,
	slowFactor: number,
	burnTicks: number,
	burnDamage: number,
	burnNext: number,
	burnOwner: Player?,
	lastAttacker: Player?,
	casting: boolean,
	charging: boolean,
	chargeDir: Vector3,
	chargeEnd: number,
	chargeHit: { [Player]: boolean },
	nextAbility: number,
	abilityIndex: number,
}

type EnemyProjectile = {
	id: number,
	position: Vector3,
	direction: Vector3,
	speed: number,
	damage: number,
	life: number,
}

local EnemyService = {}
EnemyService.Killed = Signal.new() -- (enemy, killer: Player?)
EnemyService.SealHit = Signal.new() -- (amount)

local enemies: { Enemy } = {}
local projectiles: { EnemyProjectile } = {}
local nextEnemyId = 0
local nextProjectileId = 0
local folder: Instance

local SEAL_FLAT = Vector3.new(Config.SEAL_POSITION.X, 0, Config.SEAL_POSITION.Z)
local PLAYER_AGGRO = 42
local BOSS_AGGRO = 70

local function fx(kind: string, data: { [string]: any })
	Net.event("Fx"):FireAllClients(kind, data)
end

----------------------------------------------------------------------------
-- Modelos (feitos só com peças, sem precisar de arquivos externos)
----------------------------------------------------------------------------

local function newPart(size: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Size = size
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		part.Shape = shape
	end
	return part
end

local function attach(model: Model, root: BasePart, part: BasePart, offset: CFrame, name: string)
	part.Name = name
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CFrame = root.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = part
	weld.Parent = part
	part.Parent = model
end

-- `start` é a posição inicial: a raiz é posicionada ANTES de soldar as peças,
-- assim as soldas guardam o deslocamento certo.
local function buildModel(def: any, start: CFrame): (Model, BasePart)
	local size: number = def.size
	local model = Instance.new("Model")
	model.Name = def.name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(size * 0.9, size * 0.9, size * 0.9)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = true
	root.CFrame = start
	root.Parent = model
	model.PrimaryPart = root

	local body = newPart(Vector3.one * size, def.color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	attach(model, root, body, CFrame.new(), "Corpo")

	-- Olhos (a frente do modelo é o -Z).
	local eyes: number = def.eyes
	local spacing = math.min(0.22, 0.8 / eyes) * size
	for i = 1, eyes do
		local x = (i - (eyes + 1) / 2) * spacing
		local y = size * 0.14 + (if eyes > 3 and i % 2 == 0 then size * 0.12 else 0)
		local eye = newPart(Vector3.one * size * 0.17, def.eyeColor, Enum.Material.Neon, Enum.PartType.Ball)
		attach(model, root, eye, CFrame.new(x, y, -size * 0.43), "Olho")
	end

	local mouth = newPart(Vector3.new(size * 0.5, size * 0.1, size * 0.12), Color3.fromRGB(120, 0, 20), Enum.Material.Neon)
	attach(model, root, mouth, CFrame.new(0, -size * 0.16, -size * 0.43), "Boca")

	if def.horns then
		for _, side in { -1, 1 } do
			local horn = newPart(Vector3.new(size * 0.12, size * 0.45, size * 0.12), Color3.fromRGB(230, 220, 200), Enum.Material.SmoothPlastic)
			attach(model, root, horn, CFrame.new(side * size * 0.26, size * 0.48, -size * 0.05) * CFrame.Angles(0, 0, -side * 0.45), "Chifre")
		end
	end

	if def.kind == "ranged" then
		local sac = newPart(Vector3.one * size * 0.42, def.eyeColor, Enum.Material.Neon, Enum.PartType.Ball)
		sac.Transparency = 0.25
		attach(model, root, sac, CFrame.new(0, size * 0.42, size * 0.18), "Bolsa")
	else
		for _, side in { -1, 1 } do
			local arm = newPart(Vector3.one * size * 0.32, def.color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
			attach(model, root, arm, CFrame.new(side * size * 0.52, -size * 0.12, -size * 0.12), "Braco")
		end
	end

	if def.kind == "boss" then
		for k = 1, 6 do
			local angle = (k / 6) * math.pi * 2
			local spike = newPart(Vector3.new(size * 0.08, size * 0.35, size * 0.08), def.eyeColor, Enum.Material.Neon)
			attach(
				model,
				root,
				spike,
				CFrame.new(math.cos(angle) * size * 0.3, size * 0.52, math.sin(angle) * size * 0.3)
					* CFrame.Angles(math.sin(angle) * 0.4, 0, -math.cos(angle) * 0.4),
				"Coroa"
			)
		end
		local light = Instance.new("PointLight")
		light.Color = def.eyeColor
		light.Range = size * 2.5
		light.Brightness = 2
		light.Parent = body
	end

	return model, root
end

----------------------------------------------------------------------------
-- Consultas usadas pelo combate
----------------------------------------------------------------------------

function EnemyService.all(): { Enemy }
	return enemies
end

function EnemyService.count(): number
	local count = 0
	for _, enemy in enemies do
		if enemy.alive then
			count += 1
		end
	end
	return count
end

function EnemyService.inRadius(center: Vector3, radius: number): { Enemy }
	local result = {}
	for _, enemy in enemies do
		if enemy.alive and Arena.flatDistance(enemy.position, center) <= radius + enemy.def.size / 2 then
			table.insert(result, enemy)
		end
	end
	return result
end

function EnemyService.inSegment(a: Vector3, b: Vector3, radius: number): { Enemy }
	local result = {}
	for _, enemy in enemies do
		if enemy.alive and Arena.distanceToSegment(enemy.position, a, b) <= radius + enemy.def.size / 2 then
			table.insert(result, enemy)
		end
	end
	return result
end

function EnemyService.nearest(center: Vector3, maxDistance: number, exclude: { [Enemy]: boolean }?): Enemy?
	local best: Enemy? = nil
	local bestDistance = maxDistance
	for _, enemy in enemies do
		if enemy.alive and not (exclude and exclude[enemy]) then
			local distance = Arena.flatDistance(enemy.position, center)
			if distance < bestDistance then
				best = enemy
				bestDistance = distance
			end
		end
	end
	return best
end

function EnemyService.worldPosition(enemy: Enemy): Vector3
	return enemy.root.Position
end

----------------------------------------------------------------------------
-- Dano e status
----------------------------------------------------------------------------

local function kill(enemy: Enemy)
	if not enemy.alive then
		return
	end
	enemy.alive = false
	fx("death", {
		position = enemy.root.Position,
		size = enemy.def.size,
		color = enemy.def.eyeColor,
		bodyColor = enemy.def.color,
		boss = enemy.isBoss,
	})
	enemy.model:Destroy()
	if enemy.isBoss then
		GameState.set("BossName", "")
	end
	EnemyService.Killed:Fire(enemy, enemy.lastAttacker)
end

function EnemyService.damage(enemy: Enemy, amount: number, attacker: Player?): number
	if not enemy.alive or amount ~= amount or amount <= 0 then
		return 0
	end
	local dealt = math.min(enemy.health, amount)
	enemy.health -= dealt
	if attacker then
		enemy.lastAttacker = attacker
	end
	enemy.model:SetAttribute("Health", math.max(0, math.ceil(enemy.health)))
	if enemy.isBoss then
		GameState.set("BossHealth", math.max(0, math.ceil(enemy.health)))
	end
	if enemy.health <= 0 then
		kill(enemy)
	end
	return dealt
end

function EnemyService.addBurn(enemy: Enemy, damagePerTick: number, ticks: number, owner: Player?)
	if not enemy.alive then
		return
	end
	enemy.burnTicks = math.max(enemy.burnTicks, ticks)
	enemy.burnDamage = math.max(enemy.burnDamage, damagePerTick)
	enemy.burnOwner = owner
	if enemy.burnNext < os.clock() then
		enemy.burnNext = os.clock() + 0.5
	end
	enemy.model:SetAttribute("Burning", true)
end

function EnemyService.addSlow(enemy: Enemy, factor: number, duration: number)
	if not enemy.alive then
		return
	end
	if enemy.isBoss then
		factor = 1 - (1 - factor) * 0.5
	end
	enemy.slowFactor = if os.clock() < enemy.slowUntil then math.min(enemy.slowFactor, factor) else factor
	enemy.slowUntil = math.max(enemy.slowUntil, os.clock() + duration)
	enemy.model:SetAttribute("Slowed", true)
end

-- Força positiva empurra para longe de `from`; negativa puxa para perto.
function EnemyService.knockback(enemy: Enemy, from: Vector3, strength: number)
	if not enemy.alive then
		return
	end
	local offset = Arena.flat(enemy.position - from)
	if offset.Magnitude < 0.05 then
		return
	end
	local resist = if enemy.isBoss then 0.12 else math.clamp(4 / enemy.def.size, 0.4, 1.2)
	enemy.knock += offset.Unit * strength * 6 * resist
end

----------------------------------------------------------------------------
-- Ataques contra jogadores
----------------------------------------------------------------------------

local function hurtPlayer(target: Target, amount: number)
	if target.humanoid.Health <= 0 or Run.isInvulnerable(target.player) then
		return
	end
	target.humanoid:TakeDamage(amount)
	Net.event("Fx"):FireClient(target.player, "hurt", { amount = amount })
end

local function collectTargets(): { Target }
	local targets: { Target } = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
			table.insert(targets, { player = player, humanoid = humanoid, root = root })
		end
	end
	return targets
end

local function fireProjectile(origin: Vector3, direction: Vector3, speed: number, damage: number, color: Color3, size: number)
	nextProjectileId += 1
	local range = 70
	local projectile: EnemyProjectile = {
		id = nextProjectileId,
		position = origin,
		direction = direction,
		speed = speed,
		damage = damage,
		life = range / speed,
	}
	table.insert(projectiles, projectile)
	fx("eproj", {
		id = projectile.id,
		origin = origin,
		direction = direction,
		speed = speed,
		life = projectile.life,
		color = color,
		size = size,
	})
end

local function stepProjectiles(dt: number, targets: { Target })
	for index = #projectiles, 1, -1 do
		local projectile = projectiles[index]
		projectile.position += projectile.direction * projectile.speed * dt
		projectile.life -= dt
		local hit = false
		for _, target in targets do
			local rootPosition = target.root.Position
			if
				Arena.flatDistance(rootPosition, projectile.position) < 2.4
				and math.abs(rootPosition.Y - projectile.position.Y) < 5
			then
				hurtPlayer(target, projectile.damage)
				hit = true
				break
			end
		end
		if not hit and Arena.flatDistance(projectile.position, SEAL_FLAT) < Config.SEAL_RADIUS + 1 then
			EnemyService.SealHit:Fire(projectile.damage)
			hit = true
		end
		if hit or projectile.life <= 0 then
			table.remove(projectiles, index)
			fx("eprojEnd", { id = projectile.id, position = projectile.position, hit = hit })
		end
	end
end

----------------------------------------------------------------------------
-- Habilidades de chefe
----------------------------------------------------------------------------

local function nearestTargetPosition(enemy: Enemy): Vector3
	local best = SEAL_FLAT
	local bestDistance = math.huge
	for _, target in collectTargets() do
		local distance = Arena.flatDistance(target.root.Position, enemy.position)
		if distance < bestDistance then
			bestDistance = distance
			best = target.root.Position
		end
	end
	return Arena.flat(best)
end

local function castAbility(enemy: Enemy, ability: string)
	local def = enemy.def
	if ability == "slam" then
		enemy.casting = true
		local radius = def.size * 1.5
		local center = Arena.flat(enemy.position)
		fx("telegraph", { position = center, radius = radius, duration = 1.1, color = Color3.fromRGB(255, 40, 60) })
		task.wait(1.1)
		enemy.casting = false
		if not enemy.alive then
			return
		end
		center = Arena.flat(enemy.position)
		fx("slam", { position = center, radius = radius, color = def.eyeColor })
		for _, target in collectTargets() do
			if Arena.flatDistance(target.root.Position, center) <= radius then
				hurtPlayer(target, enemy.damage * 1.3)
			end
		end
		if Arena.flatDistance(center, SEAL_FLAT) <= radius + Config.SEAL_RADIUS then
			EnemyService.SealHit:Fire(enemy.damage * 2)
		end
	elseif ability == "charge" then
		enemy.casting = true
		local destination = nearestTargetPosition(enemy)
		local offset = Arena.flat(destination - enemy.position)
		local direction = if offset.Magnitude > 0.1 then offset.Unit else enemy.facing
		local distance = 48
		enemy.facing = direction
		fx("chargeLine", {
			from = Arena.flat(enemy.position),
			to = Arena.flat(enemy.position) + direction * distance,
			width = def.size,
			duration = 0.85,
		})
		task.wait(0.85)
		enemy.casting = false
		if not enemy.alive then
			return
		end
		enemy.charging = true
		enemy.chargeDir = direction
		enemy.chargeEnd = os.clock() + distance / (def.speed * 3.4)
		enemy.chargeHit = {}
	elseif ability == "summon" then
		fx("summon", { position = enemy.root.Position, color = def.eyeColor, size = def.size })
		for i = 1, 3 do
			local angle = (i / 3) * math.pi * 2
			local position = enemy.position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * def.size
			EnemyService.spawn("menor", position, enemy.hpMult, enemy.dmgMult)
		end
	elseif ability == "volley" then
		enemy.casting = true
		fx("roar", { position = enemy.root.Position, color = def.eyeColor, size = def.size })
		task.wait(0.5)
		for ring = 0, 1 do
			if not enemy.alive then
				break
			end
			local origin = enemy.root.Position
			for i = 1, 10 do
				local angle = (i / 10) * math.pi * 2 + ring * (math.pi / 10)
				local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
				fireProjectile(
					Vector3.new(origin.X, Arena.groundHeight(origin) + 3, origin.Z) + direction * def.size * 0.5,
					direction,
					def.projectileSpeed or 50,
					enemy.damage * 0.6,
					def.eyeColor,
					1.6
				)
			end
			task.wait(0.4)
		end
		enemy.casting = false
	end
end

----------------------------------------------------------------------------
-- Criação
----------------------------------------------------------------------------

function EnemyService.spawn(defId: string, position: Vector3, hpMult: number, dmgMult: number): Enemy?
	local def = Enemies.defs[defId]
	if not def then
		return nil
	end
	nextEnemyId += 1
	local flatPosition = Arena.flat(position)
	local facing = Arena.flat(SEAL_FLAT - flatPosition)
	facing = if facing.Magnitude > 0.1 then facing.Unit else Vector3.new(0, 0, -1)
	local startY = Arena.groundHeight(flatPosition) - def.size * 0.6
	local startPosition = flatPosition + Vector3.new(0, startY, 0)
	local model, root = buildModel(def, CFrame.lookAt(startPosition, startPosition + facing))
	local maxHealth = math.max(1, math.floor(def.health * hpMult))
	local isBoss = def.kind == "boss"
	local now = os.clock()

	local enemy: Enemy = {
		id = nextEnemyId,
		def = def,
		model = model,
		root = root,
		alive = true,
		isBoss = isBoss,
		health = maxHealth,
		maxHealth = maxHealth,
		damage = def.damage * dmgMult,
		hpMult = hpMult,
		dmgMult = dmgMult,
		position = flatPosition,
		facing = facing,
		knock = Vector3.zero,
		spawnedAt = now,
		nextAttack = now + 1,
		retargetAt = 0,
		target = nil,
		slowUntil = 0,
		slowFactor = 1,
		burnTicks = 0,
		burnDamage = 0,
		burnNext = 0,
		burnOwner = nil,
		lastAttacker = nil,
		casting = false,
		charging = false,
		chargeDir = facing,
		chargeEnd = 0,
		chargeHit = {},
		nextAbility = now + 4,
		abilityIndex = 0,
	}

	model:SetAttribute("EnemyName", def.name)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("MaxHealth", maxHealth)
	model:SetAttribute("Boss", isBoss)
	model:SetAttribute("Size", def.size)
	model.Parent = folder
	table.insert(enemies, enemy)

	fx("spawn", { position = flatPosition, size = def.size, color = def.eyeColor })
	if isBoss then
		GameState.set("BossName", def.name)
		GameState.set("BossMaxHealth", maxHealth)
		GameState.set("BossHealth", maxHealth)
	end
	return enemy
end

function EnemyService.clearAll()
	for _, enemy in enemies do
		if enemy.alive then
			enemy.alive = false
			enemy.model:Destroy()
		end
	end
	table.clear(enemies)
	table.clear(projectiles)
	GameState.set("BossName", "")
	fx("clear", {})
end

----------------------------------------------------------------------------
-- Inteligência (roda todo frame)
----------------------------------------------------------------------------

local function updateEnemy(enemy: Enemy, dt: number, now: number, targets: { Target })
	local def = enemy.def
	local size: number = def.size

	-- Queimadura
	if enemy.burnTicks > 0 and now >= enemy.burnNext then
		enemy.burnTicks -= 1
		enemy.burnNext = now + 0.5
		local owner = enemy.burnOwner
		local dealt = EnemyService.damage(enemy, enemy.burnDamage, owner)
		if owner and dealt > 0 then
			Net.event("Fx"):FireClient(owner, "dmg", {
				position = enemy.root.Position + Vector3.new(0, size * 0.6, 0),
				amount = dealt,
				color = Color3.fromRGB(255, 140, 50),
			})
		end
		if not enemy.alive then
			return
		end
		if enemy.burnTicks <= 0 then
			enemy.burnDamage = 0
			enemy.model:SetAttribute("Burning", false)
		end
	end
	if enemy.slowUntil > 0 and now >= enemy.slowUntil then
		enemy.slowUntil = 0
		enemy.slowFactor = 1
		enemy.model:SetAttribute("Slowed", false)
	end

	local risen = math.clamp((now - enemy.spawnedAt) / 0.7, 0, 1)

	-- Escolhe alvo: jogador perto, senão o Selo.
	local currentTarget = enemy.target
	if currentTarget and (currentTarget.humanoid.Health <= 0 or not currentTarget.root.Parent) then
		enemy.target = nil
	end
	if now >= enemy.retargetAt then
		enemy.retargetAt = now + 0.4
		local best: Target? = nil
		local bestDistance = if enemy.isBoss then BOSS_AGGRO else PLAYER_AGGRO
		for _, target in targets do
			local distance = Arena.flatDistance(target.root.Position, enemy.position)
			if distance < bestDistance then
				best = target
				bestDistance = distance
			end
		end
		enemy.target = best
	end

	local target = enemy.target
	local targetPosition = if target then Arena.flat(target.root.Position) else SEAL_FLAT
	local targetRadius = if target then 1.5 else Config.SEAL_RADIUS
	local toTarget = targetPosition - enemy.position
	local distance = toTarget.Magnitude
	local direction = if distance > 0.01 then toTarget.Unit else enemy.facing
	local gap = distance - size / 2 - targetRadius

	-- Movimento
	local speed = def.speed * (if now < enemy.slowUntil then enemy.slowFactor else 1)
	local move = Vector3.zero
	if enemy.charging then
		move = enemy.chargeDir * def.speed * 3.4
		for _, t in targets do
			if not enemy.chargeHit[t.player] and Arena.flatDistance(t.root.Position, enemy.position) < size / 2 + 2.5 then
				enemy.chargeHit[t.player] = true
				hurtPlayer(t, enemy.damage * 1.2)
			end
		end
		if now >= enemy.chargeEnd then
			enemy.charging = false
		end
	elseif risen >= 1 and not enemy.casting then
		if def.kind == "ranged" then
			local preferred = def.preferredRange or 25
			if gap > preferred + 4 then
				move = direction * speed
			elseif gap < preferred - 6 then
				move = -direction * speed * 0.7
			end
		elseif gap > def.attackRange * 0.6 then
			move = direction * speed
		end
		if distance > 0.01 then
			enemy.facing = enemy.facing:Lerp(direction, math.min(1, dt * 8))
			if enemy.facing.Magnitude < 0.01 then
				enemy.facing = direction
			else
				enemy.facing = enemy.facing.Unit
			end
		end
	end

	-- Separação: maldições não ficam umas dentro das outras.
	local push = Vector3.zero
	for _, other in enemies do
		if other ~= enemy and other.alive then
			local offset = enemy.position - other.position
			local minimum = (size + other.def.size) * 0.45
			local d = offset.Magnitude
			if d < minimum and d > 0.01 then
				push += offset.Unit * (minimum - d)
			end
		end
	end

	local newPosition = enemy.position + (move + enemy.knock) * dt + push * math.min(1, dt * 8)
	enemy.knock *= math.exp(-6 * dt)

	-- Não atravessa o Selo nem sai do mapa.
	local fromSeal = newPosition - SEAL_FLAT
	local minimumSeal = Config.SEAL_RADIUS + size / 2
	if fromSeal.Magnitude < minimumSeal and fromSeal.Magnitude > 0.01 then
		newPosition = SEAL_FLAT + fromSeal.Unit * minimumSeal
	end
	local limit = Config.ARENA_LIMIT
	newPosition = Vector3.new(math.clamp(newPosition.X, -limit, limit), 0, math.clamp(newPosition.Z, -limit, limit))
	enemy.position = newPosition

	-- Posição final com "flutuação".
	local ground = Arena.groundHeight(newPosition)
	local bob = math.sin(now * (if enemy.isBoss then 2 else 6) + enemy.id) * size * 0.05
	local y = ground + size / 2 + bob - (1 - risen) * size * 1.1
	local worldPosition = Vector3.new(newPosition.X, y, newPosition.Z)
	local look = if enemy.charging then enemy.chargeDir else enemy.facing
	enemy.root.CFrame = CFrame.lookAt(worldPosition, worldPosition + look)

	-- Ataque básico
	if risen >= 1 and not enemy.charging and not enemy.casting and now >= enemy.nextAttack then
		if def.kind == "ranged" then
			if gap <= def.attackRange then
				enemy.nextAttack = now + def.attackCooldown
				local origin = Vector3.new(newPosition.X, ground + 3, newPosition.Z) + direction * size * 0.5
				fireProjectile(origin, direction, def.projectileSpeed or 55, enemy.damage, def.eyeColor, 1.2)
			end
		elseif gap <= def.attackRange then
			enemy.nextAttack = now + def.attackCooldown
			if target then
				hurtPlayer(target, enemy.damage)
			else
				EnemyService.SealHit:Fire(enemy.damage)
			end
			fx("enemyAttack", {
				position = worldPosition + direction * size * 0.5,
				size = size,
				color = def.eyeColor,
			})
		end
	end

	-- Habilidades de chefe
	if enemy.isBoss and risen >= 1 and now >= enemy.nextAbility and not enemy.casting and not enemy.charging then
		local abilities = def.abilities or {}
		if #abilities > 0 then
			enemy.abilityIndex = enemy.abilityIndex % #abilities + 1
			enemy.nextAbility = now + (def.abilityCooldown or 6)
			task.spawn(castAbility, enemy, abilities[enemy.abilityIndex])
		end
	end
end

local function step(dt: number)
	if #enemies == 0 and #projectiles == 0 then
		return
	end
	local now = os.clock()
	local targets = collectTargets()
	for _, enemy in table.clone(enemies) do
		if enemy.alive then
			updateEnemy(enemy, dt, now, targets)
		end
	end
	stepProjectiles(dt, targets)

	-- Remove os mortos da lista.
	for index = #enemies, 1, -1 do
		if not enemies[index].alive then
			table.remove(enemies, index)
		end
	end
end

function EnemyService.init()
	folder = Workspace:WaitForChild("Enemies")
end

function EnemyService.start()
	RunService.Heartbeat:Connect(step)
end

return EnemyService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000013">
					<Properties>
						<string name="Name">MapBuilder</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Constrói o mapa inteiro por código quando o servidor liga:
-- templo com o Selo Sagrado, portões, caminhos, 4 portais das maldições,
-- lanternas, árvores mortas, pedras e a iluminação noturna.
-- Assim o jogo funciona mesmo num lugar (place) vazio.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Arena = require(Shared:WaitForChild("Util"):WaitForChild("Arena"))

local MapBuilder = {}

MapBuilder.portals = {} :: { Vector3 }
MapBuilder.sealCrystal = nil :: Part?
MapBuilder.sealLight = nil :: PointLight?

local SEAL_COLOR = Color3.fromRGB(200, 150, 255)
local SEAL_DANGER_COLOR = Color3.fromRGB(255, 50, 70)

local COLORS = {
	ground = Color3.fromRGB(38, 44, 40),
	groundPatch = Color3.fromRGB(48, 40, 52),
	stoneDark = Color3.fromRGB(66, 62, 76),
	stone = Color3.fromRGB(86, 82, 98),
	marble = Color3.fromRGB(196, 190, 206),
	lacquer = Color3.fromRGB(165, 32, 36),
	beamDark = Color3.fromRGB(32, 26, 34),
	path = Color3.fromRGB(70, 68, 78),
	wood = Color3.fromRGB(48, 36, 36),
	rock = Color3.fromRGB(78, 74, 88),
	fire = Color3.fromRGB(255, 150, 60),
	portal = Color3.fromRGB(190, 20, 70),
	portalDark = Color3.fromRGB(25, 12, 22),
}

local function block(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		part.Shape = shape
	end
	part.Parent = parent
	return part
end

-- Cilindro em pé (no Roblox o cilindro "deita" no eixo X).
local function pillar(parent: Instance, name: string, position: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material): Part
	return block(
		parent,
		name,
		Vector3.new(height, diameter, diameter),
		CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		Enum.PartType.Cylinder
	)
end

local function disk(parent: Instance, name: string, position: Vector3, diameter: number, thickness: number, color: Color3, material: Enum.Material): Part
	return block(
		parent,
		name,
		Vector3.new(thickness, diameter, diameter),
		CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material,
		Enum.PartType.Cylinder
	)
end

local function addLight(part: BasePart, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = part
	return light
end

local function setupLighting()
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("PostEffect") or child:IsA("Clouds") then
			child:Destroy()
		end
	end

	Lighting.ClockTime = 0.6
	Lighting.Brightness = 1.6
	Lighting.Ambient = Color3.fromRGB(50, 40, 78)
	Lighting.OutdoorAmbient = Color3.fromRGB(78, 64, 118)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.36
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(118, 88, 160)
	atmosphere.Decay = Color3.fromRGB(58, 30, 92)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.9
	bloom.Size = 28
	bloom.Threshold = 0.9
	bloom.Parent = Lighting

	local grading = Instance.new("ColorCorrectionEffect")
	grading.Name = "NightGrading"
	grading.Contrast = 0.12
	grading.Saturation = 0.08
	grading.TintColor = Color3.fromRGB(232, 222, 255)
	grading.Parent = Lighting
end

local function buildGround(arena: Instance, rng: Random)
	block(arena, "Chao", Vector3.new(620, 2, 620), CFrame.new(0, -1, 0), COLORS.ground, Enum.Material.Grass)

	for i = 1, 26 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(50, 190)
		local position = Vector3.new(math.cos(angle) * radius, 0.03, math.sin(angle) * radius)
		disk(arena, "Mancha", position, rng:NextNumber(14, 34), 0.06, COLORS.groundPatch, Enum.Material.Ground)
	end

	-- Paredes invisíveis no limite do mapa.
	local limit = Config.ARENA_LIMIT + 15
	for _, data in
		{
			{ Vector3.new(limit * 2 + 4, 80, 2), Vector3.new(0, 40, limit) },
			{ Vector3.new(limit * 2 + 4, 80, 2), Vector3.new(0, 40, -limit) },
			{ Vector3.new(2, 80, limit * 2 + 4), Vector3.new(limit, 40, 0) },
			{ Vector3.new(2, 80, limit * 2 + 4), Vector3.new(-limit, 40, 0) },
		}
	do
		local wall = block(arena, "Limite", data[1], CFrame.new(data[2]), COLORS.ground, Enum.Material.SmoothPlastic)
		wall.Transparency = 1
	end
end

local function buildTemple(arena: Instance)
	local temple = Instance.new("Model")
	temple.Name = "Templo"
	temple.Parent = arena

	local tierColors = { COLORS.stoneDark, COLORS.stone, COLORS.marble }
	local tierMaterials = { Enum.Material.Slate, Enum.Material.Slate, Enum.Material.Marble }
	for index, tier in Arena.TIERS do
		local height = tier.top
		block(
			temple,
			"Degrau" .. index,
			Vector3.new(tier.half * 2, height, tier.half * 2),
			CFrame.new(0, height / 2, 0),
			tierColors[index],
			tierMaterials[index]
		)
	end

	-- Pedestal e cristal do Selo.
	local top = Arena.TIERS[#Arena.TIERS].top
	pillar(temple, "Pedestal", Vector3.new(0, top, 0), 3, 9, COLORS.stoneDark, Enum.Material.Slate)
	disk(temple, "RunaSelo", Vector3.new(0, top + 0.05, 0), 24, 0.1, Color3.fromRGB(150, 90, 230), Enum.Material.Neon).Transparency = 0.55

	local crystal = block(
		temple,
		"SeloSagrado",
		Vector3.new(4.5, 4.5, 4.5),
		CFrame.new(Config.SEAL_POSITION + Vector3.new(0, 3, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		SEAL_COLOR,
		Enum.Material.Neon
	)
	crystal.CanCollide = false
	MapBuilder.sealCrystal = crystal
	MapBuilder.sealLight = addLight(crystal, SEAL_COLOR, 40, 3)

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Color = ColorSequence.new(SEAL_COLOR)
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Transparency = NumberSequence.new(0.2)
	sparkles.Lifetime = NumberRange.new(1.2, 2)
	sparkles.Rate = 18
	sparkles.Speed = NumberRange.new(2, 5)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Parent = crystal

	local spin = TweenInfo.new(8, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1)
	TweenService:Create(crystal, spin, { CFrame = crystal.CFrame * CFrame.Angles(0, math.rad(90), 0) }):Play()

	-- Quatro colunas vermelhas e vigas, com lanternas penduradas.
	local columnHeight = 18
	local offset = 14
	for _, sign in { Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) } do
		pillar(temple, "Coluna", Vector3.new(sign.X * offset, top, sign.Z * offset), columnHeight, 2.6, COLORS.lacquer, Enum.Material.WoodPlanks)
	end
	local beamY = top + columnHeight
	for _, data in
		{
			{ Vector3.new(offset * 2 + 4, 1.4, 1.4), Vector3.new(0, beamY, offset) },
			{ Vector3.new(offset * 2 + 4, 1.4, 1.4), Vector3.new(0, beamY, -offset) },
			{ Vector3.new(1.4, 1.4, offset * 2 + 4), Vector3.new(offset, beamY, 0) },
			{ Vector3.new(1.4, 1.4, offset * 2 + 4), Vector3.new(-offset, beamY, 0) },
		}
	do
		block(temple, "Viga", data[1], CFrame.new(data[2]), COLORS.beamDark, Enum.Material.Wood)
		local lantern = block(temple, "Lanterna", Vector3.new(1.4, 2, 1.4), CFrame.new(data[2] - Vector3.new(0, 2.4, 0)), COLORS.fire, Enum.Material.Neon)
		lantern.CanCollide = false
		addLight(lantern, COLORS.fire, 16, 1.5)
	end
end

local function buildTorii(arena: Instance, base: CFrame)
	local gate = Instance.new("Model")
	gate.Name = "Portao"
	gate.Parent = arena
	local height = 16
	for _, x in { -7, 7 } do
		local position = (base * CFrame.new(x, 0, 0)).Position
		pillar(gate, "Pilar", position, height, 2.2, COLORS.lacquer, Enum.Material.WoodPlanks)
	end
	block(gate, "Kasagi", Vector3.new(23, 1.6, 2.2), base * CFrame.new(0, height + 0.8, 0), COLORS.beamDark, Enum.Material.Wood)
	block(gate, "Nuki", Vector3.new(18, 1.1, 1.4), base * CFrame.new(0, height - 3, 0), COLORS.lacquer, Enum.Material.WoodPlanks)
end

local function buildStoneLantern(arena: Instance, position: Vector3)
	local lantern = Instance.new("Model")
	lantern.Name = "LanternaDePedra"
	lantern.Parent = arena
	block(lantern, "Base", Vector3.new(2.4, 3, 2.4), CFrame.new(position + Vector3.new(0, 1.5, 0)), COLORS.stone, Enum.Material.Slate)
	local flame = block(lantern, "Chama", Vector3.new(1.6, 1.6, 1.6), CFrame.new(position + Vector3.new(0, 3.8, 0)), COLORS.fire, Enum.Material.Neon)
	block(lantern, "Teto", Vector3.new(3.4, 0.8, 3.4), CFrame.new(position + Vector3.new(0, 5, 0)), COLORS.stoneDark, Enum.Material.Slate)
	addLight(flame, COLORS.fire, 20, 2)
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 4
	fire.Color = COLORS.fire
	fire.SecondaryColor = Color3.fromRGB(255, 60, 30)
	fire.Parent = flame
end

local function buildPortal(arena: Instance, base: CFrame, rng: Random)
	local portal = Instance.new("Model")
	portal.Name = "PortalMaldito"
	portal.Parent = arena

	disk(portal, "Circulo", base.Position + Vector3.new(0, 0.06, 0), 22, 0.12, COLORS.portalDark, Enum.Material.Slate)
	disk(portal, "Runa", base.Position + Vector3.new(0, 0.1, 0), 15, 0.1, COLORS.portal, Enum.Material.Neon).Transparency = 0.4

	local rift = block(portal, "Fenda", Vector3.new(8, 15, 0.8), base * CFrame.new(0, 8.5, 0), COLORS.portal, Enum.Material.Neon)
	rift.Transparency = 0.15
	rift.CanCollide = false
	addLight(rift, COLORS.portal, 30, 3)

	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.fromRGB(60, 0, 30), Color3.fromRGB(10, 0, 10))
	smoke.LightEmission = 0.3
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 6) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(2, 3.5)
	smoke.Rate = 10
	smoke.Speed = NumberRange.new(1, 3)
	smoke.SpreadAngle = Vector2.new(40, 40)
	smoke.Parent = rift

	-- Pedras em volta do portal.
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local position = base.Position + Vector3.new(math.cos(angle) * 12, 1.5, math.sin(angle) * 12)
		local size = Vector3.new(rng:NextNumber(2, 4), rng:NextNumber(3, 7), rng:NextNumber(2, 4))
		block(
			portal,
			"Pedra",
			size,
			CFrame.new(position) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
			COLORS.rock,
			Enum.Material.Rock
		)
	end
end

local function insideLane(position: Vector3): boolean
	return math.abs(position.X) < 16 or math.abs(position.Z) < 16
end

local function buildDecoration(arena: Instance, rng: Random)
	local decor = Instance.new("Folder")
	decor.Name = "Decoracao"
	decor.Parent = arena

	local placedTrees = 0
	local attempts = 0
	while placedTrees < 45 and attempts < 400 do
		attempts += 1
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(52, 195)
		local position = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		if not insideLane(position) then
			placedTrees += 1
			local tree = Instance.new("Model")
			tree.Name = "ArvoreMorta"
			tree.Parent = decor
			local height = rng:NextNumber(10, 20)
			local trunk = pillar(tree, "Tronco", position, height, rng:NextNumber(1.4, 2.4), COLORS.wood, Enum.Material.Wood)
			trunk.CFrame = trunk.CFrame * CFrame.Angles(rng:NextNumber(-0.06, 0.06), 0, 0)
			for b = 1, rng:NextInteger(2, 4) do
				local branchLength = rng:NextNumber(4, 8)
				local branchY = height * rng:NextNumber(0.5, 0.95)
				local yaw = rng:NextNumber(0, math.pi * 2)
				local tilt = rng:NextNumber(0.5, 1.1)
				local branchCFrame = CFrame.new(position + Vector3.new(0, branchY, 0))
					* CFrame.Angles(0, yaw, 0)
					* CFrame.Angles(tilt, 0, 0)
					* CFrame.new(0, branchLength / 2, 0)
				block(tree, "Galho" .. b, Vector3.new(0.6, branchLength, 0.6), branchCFrame, COLORS.wood, Enum.Material.Wood)
			end
		end
	end

	local placedRocks = 0
	attempts = 0
	while placedRocks < 60 and attempts < 400 do
		attempts += 1
		local angle = rng:NextNumber(0, math.pi * 2)
		local radius = rng:NextNumber(42, 200)
		local position = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		if not insideLane(position) then
			placedRocks += 1
			local size = Vector3.new(rng:NextNumber(2, 7), rng:NextNumber(1.5, 5), rng:NextNumber(2, 7))
			block(
				decor,
				"Pedra",
				size,
				CFrame.new(position + Vector3.new(0, size.Y * 0.35, 0))
					* CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6.28), rng:NextNumber(-0.4, 0.4)),
				COLORS.rock,
				Enum.Material.Rock
			)
		end
	end

	-- Túmulos de pedra perto do templo, para dar clima.
	for i = 1, 16 do
		local angle = (i / 16) * math.pi * 2 + 0.2
		local position = Vector3.new(math.cos(angle) * 58, 0, math.sin(angle) * 58)
		if not insideLane(position) then
			block(
				decor,
				"Lapide",
				Vector3.new(2.6, 4, 0.8),
				CFrame.lookAt(position + Vector3.new(0, 2, 0), Vector3.new(0, 2, 0)) * CFrame.Angles(rng:NextNumber(-0.15, 0.15), 0, rng:NextNumber(-0.1, 0.1)),
				COLORS.stone,
				Enum.Material.Slate
			)
		end
	end
end

local function buildSpawn(arena: Instance)
	local top = Arena.TIERS[#Arena.TIERS].top
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnDoTemplo"
	spawn.Anchored = true
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.CFrame = CFrame.new(0, top - 0.45, 11)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = arena
end

function MapBuilder.setSealHealthFraction(fraction: number)
	local crystal = MapBuilder.sealCrystal
	local light = MapBuilder.sealLight
	if not crystal or not light then
		return
	end
	local color = SEAL_DANGER_COLOR:Lerp(SEAL_COLOR, math.clamp(fraction, 0, 1))
	crystal.Color = color
	light.Color = color
end

function MapBuilder.init()
	-- Remove o Baseplate/SpawnLocation do modelo padrão do Studio, se existir.
	for _, child in Workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end
	local old = Workspace:FindFirstChild("Arena")
	if old then
		old:Destroy()
	end

	setupLighting()

	local arena = Instance.new("Folder")
	arena.Name = "Arena"

	local rng = Random.new(1337)
	buildGround(arena, rng)
	buildTemple(arena)
	buildSpawn(arena)

	for i = 0, 3 do
		local direction = CFrame.Angles(0, i * math.pi / 2, 0)

		-- Caminho de pedra do templo até o portal.
		local pathStart, pathEnd = 36, Config.PORTAL_DISTANCE - 8
		local pathLength = pathEnd - pathStart
		block(
			arena,
			"Caminho",
			Vector3.new(10, 0.2, pathLength),
			direction * CFrame.new(0, 0.1, -(pathStart + pathLength / 2)),
			COLORS.path,
			Enum.Material.Cobblestone
		)

		buildTorii(arena, direction * CFrame.new(0, 0, -46))
		buildPortal(arena, direction * CFrame.new(0, 0, -Config.PORTAL_DISTANCE), rng)
		table.insert(MapBuilder.portals, (direction * CFrame.new(0, 0, -(Config.PORTAL_DISTANCE - 7))).Position)

		for _, distance in { 72, 112 } do
			for _, side in { -9, 9 } do
				buildStoneLantern(arena, (direction * CFrame.new(side, 0, -distance)).Position)
			end
		end
		local diagonal = CFrame.Angles(0, i * math.pi / 2 + math.pi / 4, 0)
		buildStoneLantern(arena, (diagonal * CFrame.new(0, 0, -44)).Position)
	end

	buildDecoration(arena, rng)
	arena.Parent = Workspace

	local enemies = Instance.new("Folder")
	enemies.Name = "Enemies"
	enemies.Parent = Workspace
end

return MapBuilder
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000014">
					<Properties>
						<string name="Name">PlayerData</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Progresso permanente do jogador (fragmentos, técnica, recorde de onda).
-- Usa DataStore com: UpdateAsync, tentativas com espera crescente, trava de
-- sessão (evita duplicação entre servidores), salvamento automático,
-- salvamento ao sair e ao desligar o servidor (BindToClose).

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))

export type Profile = {
	version: number,
	fragments: number,
	technique: string,
	bestWave: number,
	totalKills: number,
	rollsSinceEpic: number,
	lock: { jobId: string, time: number }?,
}

local CURRENT_VERSION = 1
local LOCK_STALE_SECONDS = Config.AUTOSAVE_INTERVAL * 2 + 60
local SERVER_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)

local PlayerData = {}
PlayerData.Loaded = Signal.new() -- (player, profile)

local profiles: { [Player]: Profile } = {}
local saveEnabled: { [Player]: boolean } = {}
local store: DataStore? = nil

local function defaultProfile(): Profile
	return {
		version = CURRENT_VERSION,
		fragments = Config.STARTING_FRAGMENTS,
		technique = "",
		bestWave = 0,
		totalKills = 0,
		rollsSinceEpic = 0,
	}
end

-- Preenche campos que faltam (dados antigos) e aplica migrações futuras.
local function reconcile(raw: any): Profile
	local profile = defaultProfile()
	if typeof(raw) == "table" then
		for key, value in raw do
			if (profile :: any)[key] ~= nil and typeof(value) == typeof((profile :: any)[key]) then
				(profile :: any)[key] = value
			end
		end
		if typeof(raw.lock) == "table" then
			profile.lock = raw.lock
		end
	end
	profile.version = CURRENT_VERSION
	return profile
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function withRetry(attempts: number, callback: () -> ()): (boolean, string?)
	local delaySeconds = 1
	local lastError: string? = nil
	for attempt = 1, attempts do
		local ok, err = pcall(callback)
		if ok then
			return true, nil
		end
		lastError = tostring(err)
		warn(`[PlayerData] tentativa {attempt}/{attempts} falhou: {err}`)
		if attempt < attempts then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 8)
		end
	end
	return false, lastError
end

type LoadStatus = "ok" | "locked" | "error"

local function claim(player: Player): (LoadStatus, Profile?)
	local dataStore = store
	if not dataStore then
		return "error", nil
	end
	local status: LoadStatus = "error"
	local loaded: Profile? = nil
	local ok = withRetry(3, function()
		dataStore:UpdateAsync(keyFor(player), function(old: any)
			local lock = if typeof(old) == "table" then old.lock else nil
			if
				typeof(lock) == "table"
				and lock.jobId ~= SERVER_ID
				and typeof(lock.time) == "number"
				and os.time() - lock.time < LOCK_STALE_SECONDS
			then
				status = "locked"
				return nil -- não escreve nada
			end
			local profile = reconcile(old)
			profile.lock = { jobId = SERVER_ID, time = os.time() }
			status = "ok"
			loaded = profile
			return profile
		end)
	end)
	if not ok then
		return "error", nil
	end
	return status, loaded
end

local function save(player: Player, release: boolean): boolean
	local profile = profiles[player]
	local dataStore = store
	if not profile or not dataStore or not saveEnabled[player] then
		return false
	end
	local ok = withRetry(3, function()
		dataStore:UpdateAsync(keyFor(player), function(old: any)
			local lock = if typeof(old) == "table" then old.lock else nil
			if typeof(lock) == "table" and lock.jobId ~= SERVER_ID then
				return nil -- outro servidor assumiu; não sobrescreve
			end
			local copy = table.clone(profile)
			copy.lock = if release then nil else { jobId = SERVER_ID, time = os.time() }
			return copy
		end)
	end)
	return ok
end

local function syncAttributes(player: Player, profile: Profile)
	player:SetAttribute("Fragments", profile.fragments)
	player:SetAttribute("Technique", profile.technique)
	player:SetAttribute("BestWave", profile.bestWave)
	player:SetAttribute("TotalKills", profile.totalKills)
	player:SetAttribute("Pity", math.max(0, Config.PITY_ROLLS - profile.rollsSinceEpic))
	local leaderstats = player:FindFirstChild("leaderstats")
	local best = leaderstats and leaderstats:FindFirstChild("Recorde")
	if best and best:IsA("IntValue") then
		best.Value = profile.bestWave
	end
end

local function onPlayerAdded(player: Player)
	local profile: Profile? = nil
	local enabled = true

	if store then
		for attempt = 1, 5 do
			local status, loaded = claim(player)
			if status == "ok" then
				profile = loaded
				break
			elseif status == "locked" then
				-- Outro servidor ainda está salvando este jogador; espera um pouco.
				task.wait(3)
			else
				break
			end
			if not player.Parent then
				return
			end
		end
	end

	if not player.Parent then
		return
	end

	if not profile then
		if RunService:IsStudio() then
			warn(
				"[PlayerData] DataStore indisponível no Studio — usando perfil temporário (não será salvo). "
					.. "Para testar o salvamento: Game Settings > Security > Enable Studio Access to API Services."
			)
			profile = defaultProfile()
			enabled = false
		else
			player:Kick("Não foi possível carregar seus dados agora. Por favor, entre de novo em instantes.")
			return
		end
	end

	local finalProfile = profile :: Profile
	profiles[player] = finalProfile
	saveEnabled[player] = enabled
	player:SetAttribute("DataLoaded", true)
	syncAttributes(player, finalProfile)
	PlayerData.Loaded:Fire(player, finalProfile)
end

function PlayerData.get(player: Player): Profile?
	return profiles[player]
end

-- Espera o perfil carregar (ou o jogador sair).
function PlayerData.waitFor(player: Player): Profile?
	while player.Parent and not profiles[player] do
		task.wait(0.2)
	end
	return profiles[player]
end

-- Chame depois de mudar o perfil, para atualizar a interface.
function PlayerData.sync(player: Player)
	local profile = profiles[player]
	if profile then
		syncAttributes(player, profile)
	end
end

function PlayerData.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[PlayerData] DataStore indisponível: " .. tostring(result))
	end
end

function PlayerData.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player, true)
		profiles[player] = nil
		saveEnabled[player] = nil
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			-- No Studio, salva rapidinho sem segurar o fim do teste.
			for player in profiles do
				task.spawn(save, player, true)
			end
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)

	-- Salvamento automático, espalhado entre os jogadores.
	while true do
		task.wait(Config.AUTOSAVE_INTERVAL)
		local list = {}
		for player in profiles do
			table.insert(list, player)
		end
		for index, player in list do
			task.delay((index - 1) * 2, function()
				if profiles[player] then
					save(player, false)
				end
			end)
		end
	end
end

return PlayerData
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000015">
					<Properties>
						<string name="Name">ShopService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Loja de melhorias (usa as moedas da partida). Preço e efeito são
-- decididos aqui no servidor; o cliente só manda o id do item.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

local Util = script.Parent.Parent:WaitForChild("Util")
local Guard = require(Util:WaitForChild("Guard"))
local RateLimit = require(Util:WaitForChild("RateLimit"))
local Run = require(Util:WaitForChild("Run"))
local CharacterService = require(script.Parent:WaitForChild("CharacterService"))
local WaveService = require(script.Parent:WaitForChild("WaveService"))

local ShopService = {}

local function notify(player: Player, text: string, color: Color3)
	Net.event("Notify"):FireClient(player, text, color)
end

local function onBuy(player: Player, upgradeId: unknown)
	if not RateLimit.allow(player, "BuyUpgrade", 4, 6) then
		return
	end
	if not Guard.shortString(upgradeId, 32) then
		return
	end
	local upgrade = Upgrades.byId[upgradeId :: string]
	if not upgrade then
		return
	end
	local phase = GameState.phase()
	if phase ~= "Wave" and phase ~= "Shop" then
		notify(player, "A loja só abre durante a partida.", Color3.fromRGB(255, 200, 120))
		return
	end
	local run = Run.get(player)
	if not run or not run.inMatch then
		return
	end

	local level = Run.upgradeLevel(player, upgrade.id)
	if level >= upgrade.maxLevel then
		notify(player, `{upgrade.name} já está no nível máximo.`, Color3.fromRGB(255, 200, 120))
		return
	end
	if upgrade.id == "selo" and WaveService.sealIsFull() then
		notify(player, "O Selo já está com a vida cheia.", Color3.fromRGB(255, 200, 120))
		return
	end
	local cost = Upgrades.cost(upgrade, level)
	if run.coins < cost then
		notify(player, "Moedas insuficientes.", Color3.fromRGB(255, 110, 110))
		return
	end

	Run.addCoins(player, -cost)
	Run.setUpgradeLevel(player, upgrade.id, level + 1)

	if upgrade.id == "selo" then
		WaveService.healSeal(Config.SEAL_HEAL_FRACTION)
		Net.event("Notify"):FireAllClients(`{player.DisplayName} restaurou o Selo Sagrado!`, Color3.fromRGB(190, 140, 255))
	else
		CharacterService.applyStats(player)
		notify(player, `{upgrade.name} → nível {level + 1}`, Color3.fromRGB(140, 255, 160))
	end
end

function ShopService.start()
	Net.event("BuyUpgrade").OnServerEvent:Connect(onBuy)
end

return ShopService
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000016">
					<Properties>
						<string name="Name">WaveService</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- O "diretor" da partida:
--   Saguão (contagem / todos prontos) → Onda → Loja → Onda → ... → Fim da Noite
-- Controla o Selo Sagrado, monta cada onda, dá recompensas e fragmentos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Enemies = require(Shared:WaitForChild("Enemies"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))

local Util = script.Parent.Parent:WaitForChild("Util")
local RateLimit = require(Util:WaitForChild("RateLimit"))
local Run = require(Util:WaitForChild("Run"))
local CharacterService = require(script.Parent:WaitForChild("CharacterService"))
local CombatService = require(script.Parent:WaitForChild("CombatService"))
local EnemyService = require(script.Parent:WaitForChild("EnemyService"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local PlayerData = require(script.Parent:WaitForChild("PlayerData"))

local WaveService = {}

local rng = Random.new()
local sealHealth = Config.SEAL_MAX_HEALTH
local lastSealAlert = 0

local GOLD = Color3.fromRGB(255, 205, 90)
local RED = Color3.fromRGB(255, 70, 80)
local PURPLE = Color3.fromRGB(190, 130, 255)

local function announce(title: string, subtitle: string, color: Color3, duration: number?)
	Net.event("Announce"):FireAllClients(title, subtitle, color, duration or 3)
end

local function notifyAll(text: string, color: Color3?)
	Net.event("Notify"):FireAllClients(text, color)
end

----------------------------------------------------------------------------
-- Selo Sagrado
----------------------------------------------------------------------------

local function setSeal(value: number)
	sealHealth = math.clamp(value, 0, Config.SEAL_MAX_HEALTH)
	GameState.set("SealHealth", math.ceil(sealHealth))
	GameState.set("SealMaxHealth", Config.SEAL_MAX_HEALTH)
	MapBuilder.setSealHealthFraction(sealHealth / Config.SEAL_MAX_HEALTH)
end

function WaveService.healSeal(fraction: number)
	setSeal(sealHealth + Config.SEAL_MAX_HEALTH * fraction)
	Net.event("Fx"):FireAllClients("sealHeal", { position = Config.SEAL_POSITION })
end

function WaveService.sealIsFull(): boolean
	return sealHealth >= Config.SEAL_MAX_HEALTH
end

----------------------------------------------------------------------------
-- Jogadores
----------------------------------------------------------------------------

local function loadedPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("DataLoaded") then
			table.insert(list, player)
		end
	end
	return list
end

local function matchPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local run = Run.get(player)
		if run and run.inMatch then
			table.insert(list, player)
		end
	end
	return list
end

local function updateCounts(): (number, number)
	local loaded = loadedPlayers()
	local ready = 0
	for _, player in loaded do
		local run = Run.get(player)
		if run and run.ready then
			ready += 1
		end
	end
	GameState.set("PlayerCount", #loaded)
	GameState.set("ReadyCount", ready)
	return #loaded, ready
end

local function clearReady()
	for _, player in Players:GetPlayers() do
		Run.setReady(player, false)
	end
	updateCounts()
end

-- Contagem regressiva; se todos apertarem "Pronto", encurta.
local function countdown(seconds: number, keepGoing: () -> boolean)
	local remaining = seconds
	while remaining > 0 do
		if not keepGoing() then
			break
		end
		GameState.set("Countdown", math.ceil(remaining))
		task.wait(0.25)
		remaining -= 0.25
		local loaded, ready = updateCounts()
		if loaded > 0 and ready >= loaded and remaining > Config.READY_COUNTDOWN then
			remaining = Config.READY_COUNTDOWN
		end
	end
	GameState.set("Countdown", 0)
end

----------------------------------------------------------------------------
-- Montagem das ondas
----------------------------------------------------------------------------

local function buildWave(wave: number, playerCount: number): { string }
	local plan: { string } = {}
	local isBoss = wave % Config.BOSS_EVERY == 0
	if isBoss then
		local bossNumber = math.floor(wave / Config.BOSS_EVERY)
		table.insert(plan, if bossNumber % 2 == 1 then "devorador" else "rainha")
	end

	local total = math.floor((5 + wave * 2.2) * (1 + 0.45 * (playerCount - 1)))
	if isBoss then
		total = math.floor(total * 0.5)
	end
	for _ = 1, total do
		local roll = rng:NextNumber()
		local id = "menor"
		if wave >= 7 and roll < 0.16 then
			id = "veloz"
		elseif wave >= 3 and roll < 0.36 then
			id = "cuspidora"
		elseif wave >= 2 and roll < 0.56 then
			id = "bruta"
		end
		table.insert(plan, id)
	end
	return plan
end

local function scaling(wave: number, playerCount: number): (number, number)
	local hpMult = (1 + 0.17 * (wave - 1)) * (1 + 0.4 * (playerCount - 1))
	local dmgMult = 1 + 0.07 * (wave - 1)
	return hpMult, dmgMult
end

type Outcome = "cleared" | "sealBroken" | "allDown" | "abandoned"

local function checkLoss(): Outcome?
	if sealHealth <= 0 then
		return "sealBroken"
	end
	local inMatch = matchPlayers()
	if #inMatch == 0 then
		return "abandoned"
	end
	if CharacterService.aliveInMatch() == 0 then
		return "allDown"
	end
	return nil
end

local function runWave(wave: number): Outcome
	GameState.set("Phase", "Wave")
	GameState.set("Wave", wave)
	clearReady()

	local playerCount = math.max(1, #matchPlayers())
	local plan = buildWave(wave, playerCount)
	local hpMult, dmgMult = scaling(wave, playerCount)
	local isBoss = wave % Config.BOSS_EVERY == 0

	if isBoss then
		local bossDef = Enemies.defs[plan[1]]
		announce(`ONDA {wave}`, `Chefe: {bossDef.name}`, RED, 3.5)
	else
		announce(`ONDA {wave}`, "As maldições estão vindo!", PURPLE, 2.5)
	end

	local spawnInterval = math.max(0.3, 1.2 - wave * 0.05)
	local index = 1
	local nextSpawn = os.clock() + 1.5
	while true do
		local loss = checkLoss()
		if loss then
			return loss
		end
		local now = os.clock()
		if index <= #plan and now >= nextSpawn and EnemyService.count() < Config.MAX_ALIVE_ENEMIES then
			local portal = MapBuilder.portals[rng:NextInteger(1, #MapBuilder.portals)]
			local jitter = Vector3.new(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6))
			EnemyService.spawn(plan[index], portal + jitter, hpMult, dmgMult)
			index += 1
			nextSpawn = now + spawnInterval
		end
		GameState.set("EnemiesLeft", (#plan - index + 1) + EnemyService.count())
		if index > #plan and EnemyService.count() == 0 then
			GameState.set("EnemiesLeft", 0)
			return "cleared"
		end
		task.wait(0.1)
	end
end

----------------------------------------------------------------------------
-- Partida
----------------------------------------------------------------------------

local function startMatch()
	EnemyService.clearAll()
	CombatService.clearAll()
	setSeal(Config.SEAL_MAX_HEALTH)
	for _, player in loadedPlayers() do
		Run.reset(player)
		Run.setInMatch(player, true)
		CombatService.resetPlayer(player)
		task.spawn(CharacterService.spawn, player)
	end
	clearReady()
	announce("A NOITE COMEÇOU", "Proteja o Selo Sagrado no centro do templo!", PURPLE, 3.5)
	task.wait(3.5)
end

local function endMatch(outcome: Outcome, wavesCleared: number)
	GameState.set("Phase", "GameOver")
	clearReady()

	if outcome ~= "abandoned" then
		local reason = if outcome == "sealBroken" then "O Selo Sagrado foi destruído." else "Todos os feiticeiros caíram."
		announce("A NOITE VENCEU", `{reason} Vocês sobreviveram a {wavesCleared} onda(s).`, RED, 6)
	end

	local best = GameState.get("BestWave") :: number
	if wavesCleared > best then
		GameState.set("BestWave", wavesCleared)
	end

	for _, player in matchPlayers() do
		local run = Run.get(player)
		local profile = PlayerData.get(player)
		if run and profile then
			local earned = wavesCleared * Config.FRAGMENTS_PER_WAVE
				+ math.floor(run.kills / Config.FRAGMENTS_PER_KILLS)
				+ run.bossKills * Config.FRAGMENTS_PER_BOSS
			profile.fragments += earned
			profile.totalKills += run.kills
			local newRecord = wavesCleared > profile.bestWave
			if newRecord then
				profile.bestWave = wavesCleared
			end
			PlayerData.sync(player)
			local message = `+{earned} fragmentos amaldiçoados! ({run.kills} abates)`
			if newRecord then
				message ..= `  •  NOVO RECORDE: {wavesCleared} ondas!`
			end
			Net.event("Notify"):FireClient(player, message, GOLD)
		end
	end

	countdown(Config.GAME_OVER_DURATION, function()
		return true
	end)

	EnemyService.clearAll()
	CombatService.clearAll()
	setSeal(Config.SEAL_MAX_HEALTH)
	GameState.set("Wave", 0)
	GameState.set("EnemiesLeft", 0)
	for _, player in Players:GetPlayers() do
		Run.reset(player)
		CombatService.resetPlayer(player)
		if player:GetAttribute("DataLoaded") then
			task.spawn(CharacterService.spawn, player)
		end
	end
end

local function lobby()
	GameState.set("Phase", "Lobby")
	GameState.set("Wave", 0)
	clearReady()
	while true do
		while #loadedPlayers() == 0 do
			GameState.set("Countdown", 0)
			task.wait(1)
		end
		countdown(Config.LOBBY_COUNTDOWN, function()
			return #loadedPlayers() > 0
		end)
		if #loadedPlayers() > 0 then
			return
		end
	end
end

local function shop(wave: number)
	GameState.set("Phase", "Shop")
	clearReady()
	CharacterService.respawnDead()
	task.delay(1, function()
		for _, player in matchPlayers() do
			CharacterService.healFull(player)
		end
	end)
	announce(`ONDA {wave} CONCLUÍDA`, "Loja aberta! Aperte B para comprar melhorias.", GOLD, 3)
	countdown(Config.SHOP_DURATION, function()
		return #matchPlayers() > 0
	end)
end

local function gameLoop()
	while true do
		lobby()
		startMatch()
		local wave = 0
		local outcome: Outcome = "cleared"
		while true do
			wave += 1
			outcome = runWave(wave)
			if outcome ~= "cleared" then
				break
			end
			-- Recompensa por onda vencida.
			local reward = Config.WAVE_CLEAR_COINS_BASE + Config.WAVE_CLEAR_COINS_PER_WAVE * wave
			for _, player in matchPlayers() do
				Run.addCoins(player, reward)
				local run = Run.get(player)
				if run and wave % Config.BOSS_EVERY == 0 then
					run.bossKills += 1
				end
			end
			notifyAll(`+{reward} moedas para todos!`, GOLD)
			shop(wave)
			if #matchPlayers() == 0 then
				outcome = "abandoned"
				break
			end
		end
		EnemyService.clearAll()
		endMatch(outcome, wave - 1)
	end
end

----------------------------------------------------------------------------

local function onToggleReady(player: Player)
	if not RateLimit.allow(player, "ToggleReady", 3, 4) then
		return
	end
	local phase = GameState.phase()
	if phase ~= "Lobby" and phase ~= "Shop" then
		return
	end
	local run = Run.ensure(player)
	Run.setReady(player, not run.ready)
	updateCounts()
end

function WaveService.init()
	setSeal(Config.SEAL_MAX_HEALTH)
end

function WaveService.start()
	Net.event("ToggleReady").OnServerEvent:Connect(onToggleReady)

	EnemyService.SealHit:Connect(function(amount: number)
		if GameState.phase() ~= "Wave" then
			return
		end
		setSeal(sealHealth - amount)
		local now = os.clock()
		if now - lastSealAlert > 1.5 then
			lastSealAlert = now
			Net.event("Fx"):FireAllClients("sealHit", { position = Config.SEAL_POSITION })
		end
	end)

	EnemyService.Killed:Connect(function(enemy: any, killer: Player?)
		local coins: number = enemy.def.coins
		if killer and killer.Parent then
			Run.addCoins(killer, coins)
			Run.addKill(killer)
		end
		-- O resto do time ganha uma parte (jogar junto compensa).
		for _, player in matchPlayers() do
			if player ~= killer then
				Run.addCoins(player, coins * 0.3)
			end
		end
		if enemy.isBoss then
			announce("CHEFE DERROTADO!", `{enemy.def.name} foi exorcizado.`, GOLD, 3)
		end
	end)

	Players.PlayerAdded:Connect(updateCounts)
	Players.PlayerRemoving:Connect(function()
		task.defer(updateCounts)
	end)

	gameLoop()
end

return WaveService
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBX00000017">
				<Properties>
					<string name="Name">Util</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000018">
					<Properties>
						<string name="Name">Guard</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Validação de argumentos vindos do cliente. Tudo que chega por remote é
-- tratado como hostil até provar o contrário.

local Guard = {}

local LIMIT = 1e5

function Guard.finiteNumber(value: unknown): boolean
	return typeof(value) == "number" and value == value and value > -LIMIT and value < LIMIT
end

function Guard.integerInRange(value: unknown, min: number, max: number): boolean
	if not Guard.finiteNumber(value) then
		return false
	end
	local n = value :: number
	return n == math.floor(n) and n >= min and n <= max
end

function Guard.vector3(value: unknown): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	local v = value :: Vector3
	return Guard.finiteNumber(v.X) and Guard.finiteNumber(v.Y) and Guard.finiteNumber(v.Z)
end

function Guard.shortString(value: unknown, maxLength: number): boolean
	return typeof(value) == "string" and #value > 0 and #value <= maxLength
end

return Guard
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000019">
					<Properties>
						<string name="Name">RateLimit</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Limite de chamadas por jogador (token bucket). Impede que alguém
-- dispare um RemoteEvent milhares de vezes por segundo.

local Players = game:GetService("Players")

type Bucket = { tokens: number, last: number }

local buckets: { [Player]: { [string]: Bucket } } = {}

local RateLimit = {}

function RateLimit.allow(player: Player, key: string, ratePerSecond: number, burst: number): boolean
	local now = os.clock()
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local bucket = playerBuckets[key]
	if not bucket then
		bucket = { tokens = burst, last = now }
		playerBuckets[key] = bucket
	end
	bucket.tokens = math.min(burst, bucket.tokens + (now - bucket.last) * ratePerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return RateLimit
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000001A">
					<Properties>
						<string name="Name">Run</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Dados de UMA partida por jogador (moedas, melhorias, energia...).
-- Some quando a partida acaba. O que fica salvo para sempre está em PlayerData.
-- Os valores são espelhados em Attributes do Player para a interface ler.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

export type RunData = {
	coins: number,
	kills: number,
	damageDealt: number,
	upgrades: { [string]: number },
	energy: number,
	ult: number,
	inMatch: boolean,
	ready: boolean,
	invulnerableUntil: number,
	domainActive: boolean,
	bossKills: number,
}

local data: { [Player]: RunData } = {}

local Run = {}

local function fresh(): RunData
	return {
		coins = 0,
		kills = 0,
		damageDealt = 0,
		upgrades = {},
		energy = Config.ENERGY_MAX,
		ult = 0,
		inMatch = false,
		ready = false,
		invulnerableUntil = 0,
		domainActive = false,
		bossKills = 0,
	}
end

local function sync(player: Player, run: RunData)
	player:SetAttribute("Coins", run.coins)
	player:SetAttribute("Energy", math.floor(run.energy))
	player:SetAttribute("MaxEnergy", Config.ENERGY_MAX)
	player:SetAttribute("Ult", math.floor(run.ult))
	player:SetAttribute("Ready", run.ready)
	player:SetAttribute("InMatch", run.inMatch)
	player:SetAttribute("Kills", run.kills)
	for _, upgrade in Upgrades.list do
		player:SetAttribute("Up_" .. upgrade.id, run.upgrades[upgrade.id] or 0)
	end
	local leaderstats = player:FindFirstChild("leaderstats")
	local killsValue = leaderstats and leaderstats:FindFirstChild("Abates")
	if killsValue and killsValue:IsA("IntValue") then
		killsValue.Value = run.kills
	end
end

function Run.get(player: Player): RunData?
	return data[player]
end

function Run.ensure(player: Player): RunData
	local run = data[player]
	if not run then
		run = fresh()
		data[player] = run
		sync(player, run)
	end
	return run
end

function Run.reset(player: Player)
	local run = fresh()
	data[player] = run
	sync(player, run)
end

function Run.all(): { [Player]: RunData }
	return data
end

function Run.addCoins(player: Player, amount: number)
	local run = Run.ensure(player)
	run.coins = math.max(0, run.coins + math.floor(amount))
	player:SetAttribute("Coins", run.coins)
end

function Run.addKill(player: Player)
	local run = Run.ensure(player)
	run.kills += 1
	sync(player, run)
end

function Run.setEnergy(player: Player, value: number)
	local run = Run.ensure(player)
	run.energy = math.clamp(value, 0, Config.ENERGY_MAX)
	local shown = math.floor(run.energy)
	if player:GetAttribute("Energy") ~= shown then
		player:SetAttribute("Energy", shown)
	end
end

function Run.setUlt(player: Player, value: number)
	local run = Run.ensure(player)
	run.ult = math.clamp(value, 0, Config.ULT_MAX)
	local shown = math.floor(run.ult)
	if player:GetAttribute("Ult") ~= shown then
		player:SetAttribute("Ult", shown)
	end
end

function Run.setReady(player: Player, ready: boolean)
	local run = Run.ensure(player)
	run.ready = ready
	player:SetAttribute("Ready", ready)
end

function Run.setInMatch(player: Player, inMatch: boolean)
	local run = Run.ensure(player)
	run.inMatch = inMatch
	player:SetAttribute("InMatch", inMatch)
end

function Run.upgradeLevel(player: Player, upgradeId: string): number
	local run = data[player]
	return if run then run.upgrades[upgradeId] or 0 else 0
end

function Run.setUpgradeLevel(player: Player, upgradeId: string, level: number)
	local run = Run.ensure(player)
	run.upgrades[upgradeId] = level
	player:SetAttribute("Up_" .. upgradeId, level)
end

local function perLevel(upgradeId: string): number
	local upgrade = Upgrades.byId[upgradeId]
	return if upgrade then upgrade.perLevel else 0
end

function Run.damageMultiplier(player: Player): number
	return 1 + perLevel("dano") * Run.upgradeLevel(player, "dano")
end

function Run.cooldownMultiplier(player: Player): number
	return math.max(0.4, 1 - perLevel("recarga") * Run.upgradeLevel(player, "recarga"))
end

function Run.energyRegenMultiplier(player: Player): number
	return 1 + perLevel("energia") * Run.upgradeLevel(player, "energia")
end

function Run.maxHealth(player: Player): number
	return Config.PLAYER_BASE_HEALTH + perLevel("vida") * Run.upgradeLevel(player, "vida")
end

function Run.walkSpeed(player: Player): number
	return Config.PLAYER_BASE_SPEED + perLevel("velocidade") * Run.upgradeLevel(player, "velocidade")
end

function Run.isInvulnerable(player: Player): boolean
	local run = data[player]
	return run ~= nil and os.clock() < run.invulnerableUntil
end

Players.PlayerRemoving:Connect(function(player)
	data[player] = nil
end)

return Run
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX0000001B">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX0000001C">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX0000001D">
				<Properties>
					<string name="Name">Client</string>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Noite Maldita — ponto de entrada do cliente.
-- Carrega os controladores (interface, controles, efeitos) em duas fases.

local Controllers = script:WaitForChild("Controllers")

local ORDER = {
	"FxController",
	"AnnouncerController",
	"HudController",
	"InputController",
	"EnemyBarsController",
	"ShopController",
	"AwakenController",
}

local loaded: { { name: string, controller: any } } = {}
local seen: { [string]: boolean } = {}

local function load(module: Instance)
	if module:IsA("ModuleScript") and not seen[module.Name] then
		seen[module.Name] = true
		table.insert(loaded, { name = module.Name, controller = require(module) :: any })
	end
end

for _, name in ORDER do
	local module = Controllers:WaitForChild(name, 5)
	if module then
		load(module)
	end
end
for _, module in Controllers:GetChildren() do
	load(module)
end

for _, entry in loaded do
	if typeof(entry.controller.init) == "function" then
		entry.controller.init()
	end
end

for _, entry in loaded do
	if typeof(entry.controller.start) == "function" then
		task.spawn(entry.controller.start)
	end
end

print("[NoiteMaldita] cliente iniciado")
]]></ProtectedString>
				</Properties>
				<Item class="Folder" referent="RBX0000001E">
					<Properties>
						<string name="Name">Controllers</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX0000001F">
						<Properties>
							<string name="Name">AnnouncerController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Avisos grandes no meio da tela ("ONDA 5", "CHEFE DERROTADO!") e
-- mensagens pequenas empilhadas ("+30 moedas", "Moedas insuficientes").

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local Ui = require(ClientUtil:WaitForChild("Ui"))
local ClientState = require(ClientUtil:WaitForChild("ClientState"))
local Sfx = require(ClientUtil:WaitForChild("Sfx"))

local AnnouncerController = {}

type Announcement = { title: string, subtitle: string, color: Color3, duration: number }

local gui: ScreenGui
local banner: Frame
local titleLabel: TextLabel
local subtitleLabel: TextLabel
local toastList: Frame
local queue: { Announcement } = {}
local showing = false

local function setBannerTransparency(value: number, time: number)
	local info = TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(titleLabel, info, { TextTransparency = value }):Play()
	TweenService:Create(subtitleLabel, info, { TextTransparency = value }):Play()
	for _, label in { titleLabel, subtitleLabel } do
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, info, { Transparency = math.max(value, 0.2) }):Play()
		end
	end
end

local function showNext()
	if showing then
		return
	end
	local item = table.remove(queue, 1)
	if not item then
		return
	end
	showing = true
	titleLabel.Text = item.title
	titleLabel.TextColor3 = item.color
	subtitleLabel.Text = item.subtitle
	banner.Position = UDim2.fromScale(0.5, 0.24)
	titleLabel.TextSize = Ui.s(70)
	TweenService:Create(titleLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = Ui.s(54) }):Play()
	setBannerTransparency(0, 0.25)
	Sfx.play("ui", 0.4, 0.7)
	task.delay(item.duration, function()
		setBannerTransparency(1, 0.4)
		task.wait(0.45)
		showing = false
		showNext()
	end)
end

function AnnouncerController.announce(title: string, subtitle: string, color: Color3, duration: number)
	-- Se a fila crescer demais, descarta os mais antigos.
	if #queue >= 3 then
		table.remove(queue, 1)
	end
	table.insert(queue, { title = title, subtitle = subtitle, color = color, duration = duration })
	showNext()
end

function AnnouncerController.toast(text: string, color: Color3?)
	local label = Ui.label({
		Size = UDim2.new(1, 0, 0, Ui.s(28)),
		Text = text,
		TextColor3 = color or Ui.TEXT,
		TextSize = Ui.s(19),
		Font = Ui.FONT_HEAVY,
		LayoutOrder = math.floor(os.clock() * 1000),
		Parent = toastList,
	})
	local stroke = Ui.textStroke(0.2)
	stroke.Parent = label
	local children = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(children, child)
		end
	end
	if #children > 4 then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end
	task.delay(2.6, function()
		if label.Parent then
			TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
			task.wait(0.55)
			label:Destroy()
		end
	end)
end

function AnnouncerController.init()
	gui = Ui.screen("Announcer", 30)
	banner = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.24),
		Size = UDim2.new(0.9, 0, 0, Ui.s(110)),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	titleLabel = Ui.label({
		Size = UDim2.new(1, 0, 0, Ui.s(64)),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(54),
		TextTransparency = 1,
		Parent = banner,
	})
	Ui.textStroke(1).Parent = titleLabel
	subtitleLabel = Ui.label({
		Position = UDim2.new(0, 0, 0, Ui.s(66)),
		Size = UDim2.new(1, 0, 0, Ui.s(30)),
		TextSize = Ui.s(22),
		TextWrapped = true,
		TextTransparency = 1,
		Parent = banner,
	})
	Ui.textStroke(1).Parent = subtitleLabel

	toastList = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -Ui.s(if Ui.isTouch() then 40 else 150)),
		Size = UDim2.new(0.8, 0, 0, Ui.s(160)),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Ui.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, Ui.s(2)),
		Parent = toastList,
	})
end

function AnnouncerController.start()
	Net.event("Announce").OnClientEvent:Connect(function(title: string, subtitle: string, color: Color3, duration: number)
		if typeof(title) == "string" and typeof(subtitle) == "string" then
			AnnouncerController.announce(
				title,
				subtitle,
				if typeof(color) == "Color3" then color else Ui.TEXT,
				if typeof(duration) == "number" then math.clamp(duration, 0.5, 10) else 3
			)
		end
	end)
	Net.event("Notify").OnClientEvent:Connect(function(text: string, color: Color3?)
		if typeof(text) == "string" then
			AnnouncerController.toast(text, if typeof(color) == "Color3" then color else nil)
		end
	end)
	ClientState.Notify:Connect(function(text: string, color: Color3?)
		AnnouncerController.toast(text, color)
	end)
end

return AnnouncerController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000020">
						<Properties>
							<string name="Name">AwakenController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Tela do Despertar: mostra a técnica atual e faz o sorteio de uma nova
-- (com animação de "roleta"). O sorteio de verdade acontece no servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Techniques = require(Shared:WaitForChild("Techniques"))

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local Ui = require(ClientUtil:WaitForChild("Ui"))
local ClientState = require(ClientUtil:WaitForChild("ClientState"))
local Sfx = require(ClientUtil:WaitForChild("Sfx"))

local player = Players.LocalPlayer

local AwakenController = {}

local gui: ScreenGui
local panel: Frame
local card: Frame
local cardStroke: UIStroke
local nameLabel: TextLabel
local rarityLabel: TextLabel
local descriptionLabel: TextLabel
local skillsLabel: TextLabel
local fragmentsLabel: TextLabel
local pityLabel: TextLabel
local rollButton: TextButton
local rolling = false
local openedOnce = false

local function canRoll(): boolean
	local phase = GameState.phase()
	return phase == "Lobby" or phase == "GameOver"
end

local function showTechnique(technique: any)
	local rarity = Techniques.RARITY[technique.rarity]
	nameLabel.Text = technique.name
	nameLabel.TextColor3 = technique.color:Lerp(Color3.new(1, 1, 1), 0.25)
	rarityLabel.Text = string.upper(rarity.name)
	rarityLabel.TextColor3 = rarity.color
	cardStroke.Color = rarity.color
	descriptionLabel.Text = `{technique.description}\nEfeito: {technique.effectText}`
	local lines = {}
	local keys = if Ui.isTouch() then { "1", "2", "3" } else { "Z", "X", "C" }
	for index, skill in technique.skills do
		table.insert(lines, `{keys[index]}  •  {skill.name}`)
	end
	table.insert(lines, `{if Ui.isTouch() then "★" else "V"}  •  {technique.domain.name}`)
	skillsLabel.Text = table.concat(lines, "\n")
end

local function refresh()
	if rolling then
		return
	end
	local technique = Techniques.byId[player:GetAttribute("Technique") :: string? or ""]
	if technique then
		showTechnique(technique)
	end
	local fragments = (player:GetAttribute("Fragments") :: number?) or 0
	fragmentsLabel.Text = `Fragmentos: {Ui.formatNumber(fragments)}`
	local pity = (player:GetAttribute("Pity") :: number?) or Config.PITY_ROLLS
	pityLabel.Text = if pity <= 1 then "A próxima rolagem é Épica ou melhor!" else `Épico ou melhor garantido em {pity} rolagens`
	local affordable = fragments >= Config.REROLL_COST
	rollButton.Text = `DESPERTAR NOVA TÉCNICA  ({Config.REROLL_COST} fragmentos)`
	rollButton.BackgroundColor3 = if affordable and canRoll() then Color3.fromRGB(110, 60, 190) else Color3.fromRGB(60, 50, 75)
end

local function setOpen(open: boolean)
	if open and not canRoll() then
		ClientState.Notify:Fire("Você pode trocar de técnica no saguão, entre as noites.", Color3.fromRGB(255, 200, 120))
		return
	end
	panel.Visible = open
	if open then
		refresh()
	end
end

-- Animação de roleta: troca nomes cada vez mais devagar e revela o resultado.
local function playRoll(resultId: string)
	local result = Techniques.byId[resultId]
	if not result then
		return
	end
	rolling = true
	panel.Visible = true
	local delay = 0.05
	local elapsed = 0
	while elapsed < 1.8 do
		local random = Techniques.list[math.random(1, #Techniques.list)]
		showTechnique(random)
		Sfx.play("ui", 0.25, 1.5)
		task.wait(delay)
		elapsed += delay
		delay *= 1.18
	end
	showTechnique(result)
	rolling = false
	refresh()

	local rarity = Techniques.RARITY[result.rarity]
	Sfx.play("boom", 0.6, if rarity.rank >= 3 then 0.6 else 1)
	card.BackgroundColor3 = rarity.color
	Ui.tween(card, 0.6, { BackgroundColor3 = Ui.PANEL_LIGHT })
	ClientState.Notify:Fire(`Você despertou {result.name} ({rarity.name})!`, rarity.color)
end

local function build()
	gui = Ui.screen("Awaken", 25)
	panel = Ui.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = Ui.px(560, 470),
		Visible = false,
		Parent = gui,
	})
	Ui.padding(18).Parent = panel

	local title = Ui.label({
		Size = UDim2.new(1, 0, 0, Ui.s(34)),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(28),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "DESPERTAR",
		TextColor3 = Ui.ACCENT,
		Parent = panel,
	})
	Ui.textStroke(0.3).Parent = title

	local close = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = Ui.px(34, 34),
		Text = "X",
		BackgroundColor3 = Color3.fromRGB(90, 40, 50),
		Parent = panel,
	})
	close.Activated:Connect(function()
		if not rolling then
			setOpen(false)
		end
	end)

	card = Ui.new("Frame", {
		Position = UDim2.new(0, 0, 0, Ui.s(46)),
		Size = UDim2.new(1, 0, 0, Ui.s(270)),
		BackgroundColor3 = Ui.PANEL_LIGHT,
		BackgroundTransparency = 0.1,
		Parent = panel,
	})
	Ui.corner(10).Parent = card
	cardStroke = Ui.stroke(Ui.ACCENT, 2.5, 0)
	cardStroke.Parent = card
	Ui.padding(14).Parent = card

	rarityLabel = Ui.label({
		Size = UDim2.new(1, 0, 0, Ui.s(20)),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(16),
		Parent = card,
	})
	nameLabel = Ui.label({
		Position = UDim2.new(0, 0, 0, Ui.s(20)),
		Size = UDim2.new(1, 0, 0, Ui.s(40)),
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(34),
		Parent = card,
	})
	Ui.textStroke(0.3).Parent = nameLabel
	descriptionLabel = Ui.label({
		Position = UDim2.new(0, 0, 0, Ui.s(66)),
		Size = UDim2.new(1, 0, 0, Ui.s(60)),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Font = Ui.FONT_BODY,
		TextSize = Ui.s(15),
		TextColor3 = Ui.MUTED,
		Parent = card,
	})
	skillsLabel = Ui.label({
		Position = UDim2.new(0, 0, 0, Ui.s(132)),
		Size = UDim2.new(1, 0, 0, Ui.s(110)),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextSize = Ui.s(17),
		LineHeight = 1.2,
		Parent = card,
	})

	fragmentsLabel = Ui.label({
		Position = UDim2.new(0, 0, 0, Ui.s(326)),
		Size = UDim2.new(0.5, 0, 0, Ui.s(22)),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.ACCENT,
		TextSize = Ui.s(17),
		Parent = panel,
	})
	pityLabel = Ui.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, Ui.s(326)),
		Size = UDim2.new(0.5, 0, 0, Ui.s(22)),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Ui.MUTED,
		Font = Ui.FONT_BODY,
		TextSize = Ui.s(14),
		Parent = panel,
	})

	rollButton = Ui.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.new(1, 0, 0, Ui.s(56)),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(18),
		Parent = panel,
	})
	Ui.stroke(Ui.ACCENT, 2, 0.2).Parent = rollButton
	rollButton.Activated:Connect(function()
		if rolling then
			return
		end
		if not canRoll() then
			ClientState.Notify:Fire("Só dá para despertar no saguão.", Color3.fromRGB(255, 200, 120))
			return
		end
		Sfx.play("ui", 0.5)
		Net.event("Reroll"):FireServer()
	end)
end

function AwakenController.init()
	build()
end

function AwakenController.start()
	ClientState.ToggleAwaken:Connect(function()
		setOpen(not panel.Visible)
	end)
	Net.event("RerollResult").OnClientEvent:Connect(function(techniqueId: string)
		if typeof(techniqueId) == "string" then
			playRoll(techniqueId)
		end
	end)
	for _, key in { "Technique", "Fragments", "Pity" } do
		player:GetAttributeChangedSignal(key):Connect(refresh)
	end
	GameState.onChanged("Phase", function()
		if not canRoll() and not rolling then
			panel.Visible = false
		end
		refresh()
	end)

	-- Mostra a técnica assim que ela despertar pela primeira vez.
	local function tryAutoOpen()
		if openedOnce or not canRoll() then
			return
		end
		if Techniques.byId[player:GetAttribute("Technique") :: string? or ""] then
			openedOnce = true
			setOpen(true)
			if player:GetAttribute("FirstAwaken") == true then
				ClientState.Notify:Fire("Sua técnica de feitiçaria despertou!", Ui.ACCENT)
			end
		end
	end
	player:GetAttributeChangedSignal("Technique"):Connect(tryAutoOpen)
	task.delay(1.5, tryAutoOpen)
	refresh()
end

return AwakenController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000021">
						<Properties>
							<string name="Name">EnemyBarsController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Barra de vida em cima de cada maldição, piscada branca ao levar dano,
-- fogo quando queimando e cor de gelo quando lenta.

local Workspace = game:GetService("Workspace")

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local Ui = require(ClientUtil:WaitForChild("Ui"))

local EnemyBarsController = {}

local ICE = Color3.fromRGB(150, 215, 255)

local function setup(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local root = model:WaitForChild("Root", 5)
	local body = model:WaitForChild("Corpo", 5)
	if not root or not root:IsA("BasePart") or not body or not body:IsA("BasePart") then
		return
	end
	local baseColor = body.Color
	local baseMaterial = body.Material
	local size = (model:GetAttribute("Size") :: number?) or 4
	local isBoss = model:GetAttribute("Boss") == true

	local function restoreLook()
		if not body.Parent then
			return
		end
		if model:GetAttribute("Slowed") == true then
			body.Color = baseColor:Lerp(ICE, 0.6)
			body.Material = Enum.Material.Ice
		else
			body.Color = baseColor
			body.Material = baseMaterial
		end
	end

	local fill: Frame? = nil
	if not isBoss then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Vida"
		billboard.Adornee = root
		billboard.Size = UDim2.new(2.5 + size * 0.5, 0, 0, Ui.s(26))
		billboard.StudsOffset = Vector3.new(0, size * 0.5 + 1.4, 0)
		billboard.MaxDistance = 140
		billboard.LightInfluence = 0
		billboard.Parent = model

		local name = Ui.label({
			Size = UDim2.new(1, 0, 0, Ui.s(14)),
			TextSize = Ui.s(12),
			TextColor3 = Color3.fromRGB(255, 200, 210),
			Text = (model:GetAttribute("EnemyName") :: string?) or "",
			Parent = billboard,
		})
		Ui.textStroke(0.3).Parent = name

		local back = Ui.new("Frame", {
			Position = UDim2.new(0, 0, 0, Ui.s(15)),
			Size = UDim2.new(1, 0, 0, Ui.s(8)),
			BackgroundColor3 = Color3.fromRGB(20, 10, 15),
			BorderSizePixel = 0,
			Parent = billboard,
		})
		Ui.corner(4).Parent = back
		local bar = Ui.new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(230, 50, 70),
			BorderSizePixel = 0,
			Parent = back,
		})
		Ui.corner(4).Parent = bar
		fill = bar
	end

	local lastHealth = (model:GetAttribute("Health") :: number?) or 1
	model:GetAttributeChangedSignal("Health"):Connect(function()
		local health = (model:GetAttribute("Health") :: number?) or 0
		local maxHealth = math.max(1, (model:GetAttribute("MaxHealth") :: number?) or 1)
		if fill then
			fill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
		end
		if health < lastHealth and body.Parent then
			body.Color = Color3.new(1, 1, 1)
			body.Material = Enum.Material.Neon
			task.delay(0.07, restoreLook)
		end
		lastHealth = health
	end)

	model:GetAttributeChangedSignal("Slowed"):Connect(restoreLook)

	model:GetAttributeChangedSignal("Burning"):Connect(function()
		local existing = body:FindFirstChild("Queimando")
		if model:GetAttribute("Burning") == true then
			if not existing then
				local fire = Instance.new("Fire")
				fire.Name = "Queimando"
				fire.Size = size * 0.8
				fire.Heat = 5
				fire.Color = Color3.fromRGB(255, 110, 40)
				fire.SecondaryColor = Color3.fromRGB(255, 40, 20)
				fire.Parent = body
			end
		elseif existing then
			existing:Destroy()
		end
	end)
end

function EnemyBarsController.start()
	local folder = Workspace:WaitForChild("Enemies")
	folder.ChildAdded:Connect(function(child)
		task.spawn(setup, child)
	end)
	for _, child in folder:GetChildren() do
		task.spawn(setup, child)
	end
end

return EnemyBarsController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000022">
						<Properties>
							<string name="Name">FxController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Todos os efeitos visuais: projéteis, explosões, Territórios, raios,
-- avisos de ataque dos chefes, números de dano, tremor de câmera.
-- O servidor manda "o que aconteceu"; aqui só desenhamos (peças locais).

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Arena = require(Shared:WaitForChild("Util"):WaitForChild("Arena"))

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local Ui = require(ClientUtil:WaitForChild("Ui"))
local Sfx = require(ClientUtil:WaitForChild("Sfx"))
local ClientState = require(ClientUtil:WaitForChild("ClientState"))

local player = Players.LocalPlayer

local FxController = {}

type Moving = {
	part: BasePart,
	origin: Vector3,
	direction: Vector3,
	speed: number,
	maxDistance: number,
	startedAt: number,
	spin: boolean,
}

local folder: Folder
local overlay: ScreenGui
local hurtFrame: Frame
local projectiles: { [string]: Moving } = {}
local orbiters: { { part: BasePart, center: Vector3, radius: number, height: number, speed: number, offset: number, endsAt: number } } =
	{}

local shakeIntensity = 0
local shakeUntil = 0

----------------------------------------------------------------------------
-- Ajudantes
----------------------------------------------------------------------------

local function newPart(size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Neon
	if shape then
		part.Shape = shape
	end
	part.Parent = folder
	return part
end

local function fadeOut(part: BasePart, time: number, extra: { [string]: any }?)
	local goal: { [string]: any } = { Transparency = 1 }
	if extra then
		for key, value in extra do
			goal[key] = value
		end
	end
	TweenService:Create(part, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	Debris:AddItem(part, time + 0.05)
end

-- Disco deitado (cilindro do Roblox "deita" no eixo X).
local function flatDiskCFrame(position: Vector3): CFrame
	return CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
end

local function groundAt(position: Vector3): number
	return Arena.groundHeight(position)
end

local function distanceToMe(position: Vector3): number
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return (root.Position - position).Magnitude
	end
	return math.huge
end

function FxController.shake(intensity: number, duration: number)
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

local function shakeNear(position: Vector3, intensity: number, radius: number, duration: number)
	local distance = distanceToMe(position)
	if distance < radius then
		FxController.shake(intensity * (1 - distance / radius), duration)
	end
end

local function ring(position: Vector3, fromDiameter: number, toDiameter: number, color: Color3, time: number, transparency: number?)
	local part = newPart(Vector3.new(0.3, fromDiameter, fromDiameter), flatDiskCFrame(position), color, Enum.Material.Neon, Enum.PartType.Cylinder)
	part.Transparency = transparency or 0.2
	fadeOut(part, time, { Size = Vector3.new(0.3, toDiameter, toDiameter) })
end

local function sphere(position: Vector3, fromDiameter: number, toDiameter: number, color: Color3, time: number, material: Enum.Material?, transparency: number?)
	local part = newPart(Vector3.one * fromDiameter, CFrame.new(position), color, material or Enum.Material.Neon, Enum.PartType.Ball)
	part.Transparency = transparency or 0.3
	fadeOut(part, time, { Size = Vector3.one * toDiameter })
end

local function sparks(position: Vector3, color: Color3, count: number, speed: number, size: number)
	for _ = 1, count do
		local direction = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5)
		if direction.Magnitude < 0.05 then
			direction = Vector3.yAxis
		end
		direction = direction.Unit
		local part = newPart(Vector3.one * size, CFrame.new(position), color)
		local goal = CFrame.new(position + direction * speed * (0.6 + math.random() * 0.6))
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		fadeOut(part, 0.45 + math.random() * 0.25, { CFrame = goal, Size = Vector3.one * size * 0.2 })
	end
end

local function lightning(from: Vector3, to: Vector3, color: Color3, segments: number, jitter: number, time: number)
	local previous = from
	for i = 1, segments do
		local t = i / segments
		local point = from:Lerp(to, t)
		if i < segments then
			point += Vector3.new((math.random() - 0.5) * jitter, (math.random() - 0.5) * jitter, (math.random() - 0.5) * jitter)
		end
		local length = (point - previous).Magnitude
		if length > 0.05 then
			local part = newPart(Vector3.new(0.35, 0.35, length), CFrame.lookAt(previous:Lerp(point, 0.5), point), color)
			fadeOut(part, time)
		end
		previous = point
	end
end

local function addTrail(part: BasePart, color: Color3, color2: Color3, width: number)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, width / 2, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -width / 2, 0)
	a1.Parent = part
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color, color2)
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Lifetime = 0.25
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Parent = part
end

local function floatingText(position: Vector3, text: string, color: Color3, size: number, rise: number)
	local anchor = newPart(Vector3.one * 0.2, CFrame.new(position + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2)), color)
	anchor.Transparency = 1
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(Ui.s(140), Ui.s(50))
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	billboard.MaxDistance = 200
	billboard.Adornee = anchor
	billboard.StudsOffset = Vector3.zero
	billboard.Parent = anchor
	local label = Ui.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextColor3 = color,
		TextSize = Ui.s(size),
		Font = Ui.FONT_HEAVY,
		Parent = billboard,
	})
	Ui.textStroke(0.1).Parent = label
	TweenService:Create(billboard, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = Vector3.new(0, rise, 0),
	}):Play()
	task.delay(0.45, function()
		TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, TweenInfo.new(0.35), { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(anchor, 0.85)
end

local function colorFlash(tint: Color3, time: number)
	local effect = Instance.new("ColorCorrectionEffect")
	effect.TintColor = tint
	effect.Brightness = 0.08
	effect.Saturation = 0.2
	effect.Parent = Lighting
	TweenService:Create(effect, TweenInfo.new(time), {
		TintColor = Color3.new(1, 1, 1),
		Brightness = 0,
		Saturation = 0,
	}):Play()
	Debris:AddItem(effect, time + 0.1)
end

----------------------------------------------------------------------------
-- Formatos dos projéteis por técnica
----------------------------------------------------------------------------

local SPEAR_TECHS = { gelo = true, sol = true, trovao = true }

local function createProjectile(data: { [string]: any }): BasePart
	local radius: number = data.radius or 3
	local color: Color3 = data.color
	local color2: Color3 = data.color2 or color
	local direction: Vector3 = data.direction
	local origin: Vector3 = data.origin
	local visual = math.clamp(radius * 0.55, 1, 4.5)
	local part: BasePart
	if data.tech == "vento" then
		part = newPart(Vector3.new(visual * 2.4, 0.35, visual * 0.6), CFrame.lookAt(origin, origin + direction), color)
	elseif SPEAR_TECHS[data.tech] then
		part = newPart(Vector3.new(visual * 0.45, visual * 0.45, visual * 2.6), CFrame.lookAt(origin, origin + direction), color)
	else
		part = newPart(Vector3.one * visual * 1.3, CFrame.new(origin), color, Enum.Material.Neon, Enum.PartType.Ball)
		local core = newPart(Vector3.one * visual * 0.7, CFrame.new(origin), color2, Enum.Material.Neon, Enum.PartType.Ball)
		local weld = Instance.new("WeldConstraint")
		core.Anchored = false
		weld.Part0 = part
		weld.Part1 = core
		weld.Parent = core
		core.Parent = part
	end
	addTrail(part, color, color2, visual)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 2
	light.Parent = part
	return part
end

----------------------------------------------------------------------------
-- Tratadores de cada efeito
----------------------------------------------------------------------------

local handlers: { [string]: (data: { [string]: any }) -> () } = {}

handlers.proj = function(data)
	local part = createProjectile(data)
	projectiles["p" .. tostring(data.id)] = {
		part = part,
		origin = data.origin,
		direction = data.direction,
		speed = data.speed,
		maxDistance = data.range,
		startedAt = os.clock(),
		spin = data.tech == "vento",
	}
	Sfx.play("shoot", 0.35, 1 + math.random() * 0.2, data.origin)
end

handlers.projEnd = function(data)
	local key = "p" .. tostring(data.id)
	local moving = projectiles[key]
	if moving then
		projectiles[key] = nil
		moving.part:Destroy()
	end
	local position: Vector3 = data.position
	local radius: number = data.radius or 3
	sphere(position, 1, math.max(4, radius * 1.6), data.color, 0.3)
	sparks(position, data.color, 5, 6, 0.5)
end

handlers.burst = function(data)
	local position: Vector3 = data.position
	local radius: number = data.radius
	local ground = Vector3.new(position.X, groundAt(position) + 0.2, position.Z)
	ring(ground, 2, radius * 2, data.color, 0.45, 0.15)
	ring(ground, 1, radius * 1.5, data.color2, 0.6, 0.4)
	sphere(position, 3, radius * 2, data.color, 0.4, Enum.Material.ForceField, 0.1)
	sparks(position, data.color2, 14, radius * 0.8, 0.8)
	if data.tech == "trovao" then
		for _ = 1, 5 do
			local angle = math.random() * math.pi * 2
			local target = ground + Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * math.random()
			lightning(target + Vector3.new(0, 30, 0), target, data.color, 7, 3, 0.3)
		end
	end
	shakeNear(position, 0.6, 40, 0.25)
	Sfx.play("boom", 0.5, 0.9, position)
end

handlers.dash = function(data)
	local from: Vector3 = data.from
	local to: Vector3 = data.to
	local length = (to - from).Magnitude
	if length < 0.5 then
		return
	end
	local beam = newPart(Vector3.new(2.2, 2.2, length), CFrame.lookAt(from:Lerp(to, 0.5), to), data.color)
	beam.Transparency = 0.3
	fadeOut(beam, 0.4, { Size = Vector3.new(0.2, 0.2, length) })
	for i = 1, 4 do
		sphere(from:Lerp(to, i / 4), 1, 5, data.color2, 0.35)
	end
	Sfx.play("slash", 0.5, 1.2, from)
end

handlers.m1 = function(data)
	local position: Vector3 = data.position
	local direction: Vector3 = data.direction
	local finisher = data.finisher == true
	local comboStep: number = data.combo or 1
	local center = position + direction * 4
	local tilt = if comboStep % 2 == 0 then -0.7 else 0.7
	local length = if finisher then 9 else 6
	local slash = newPart(
		Vector3.new(length, 0.25, 0.6),
		CFrame.lookAt(center, center + direction) * CFrame.Angles(0, 0, tilt),
		data.color
	)
	slash.Transparency = 0.1
	fadeOut(slash, 0.18, { Size = Vector3.new(length * 1.3, 0.05, 0.2) })
	if finisher then
		ring(Vector3.new(center.X, groundAt(center) + 0.2, center.Z), 2, 12, data.color, 0.35, 0.2)
		sparks(center, data.color, 6, 6, 0.5)
		shakeNear(position, 0.35, 15, 0.15)
	end
	Sfx.play("slash", 0.35, if finisher then 0.8 else 1 + comboStep * 0.08, position)
end

handlers.chain = function(data)
	lightning(data.from, data.to, data.color, 6, 2.5, 0.25)
end

handlers.domain = function(data)
	local center: Vector3 = data.position
	local radius: number = data.radius
	local duration: number = data.duration
	local color: Color3 = data.color
	local color2: Color3 = data.color2
	local ground = Vector3.new(center.X, 0.15, center.Z)

	local dome = newPart(Vector3.one * 4, CFrame.new(ground), color, Enum.Material.ForceField, Enum.PartType.Ball)
	dome.Transparency = 0
	TweenService:Create(dome, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = Vector3.one * radius * 2,
	}):Play()

	local floor = newPart(Vector3.new(0.2, 2, 2), flatDiskCFrame(ground), color, Enum.Material.Neon, Enum.PartType.Cylinder)
	floor.Transparency = 0.65
	TweenService:Create(floor, TweenInfo.new(0.6), { Size = Vector3.new(0.2, radius * 2, radius * 2) }):Play()

	local inner = newPart(Vector3.new(0.25, 2, 2), flatDiskCFrame(ground + Vector3.new(0, 0.05, 0)), color2, Enum.Material.Neon, Enum.PartType.Cylinder)
	inner.Transparency = 0.5
	TweenService:Create(inner, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = Vector3.new(0.25, radius * 2, radius * 2) }):Play()

	local endsAt = os.clock() + duration
	for i = 1, 6 do
		local orb = newPart(Vector3.one * 2.2, CFrame.new(ground), color2, Enum.Material.Neon, Enum.PartType.Ball)
		local light = Instance.new("PointLight")
		light.Color = color2
		light.Range = 14
		light.Brightness = 2
		light.Parent = orb
		table.insert(orbiters, {
			part = orb,
			center = ground,
			radius = radius * 0.7,
			height = 8 + (i % 2) * 4,
			speed = 1.6,
			offset = (i / 6) * math.pi * 2,
			endsAt = endsAt,
		})
	end

	colorFlash(color:Lerp(Color3.new(1, 1, 1), 0.35), 1.2)
	shakeNear(center, 1.2, radius * 3, 0.6)
	Sfx.play("boom", 0.8, 0.6, center)

	task.delay(duration, function()
		for _, part in { dome, floor, inner } do
			if part.Parent then
				fadeOut(part, 0.5)
			end
		end
	end)
end

handlers.domainEnd = function(_data) end

handlers.eproj = function(data)
	local origin: Vector3 = data.origin
	local size: number = data.size or 1.2
	local part = newPart(Vector3.one * size * 1.4, CFrame.new(origin), data.color, Enum.Material.Neon, Enum.PartType.Ball)
	addTrail(part, data.color, Color3.new(0, 0, 0), size)
	projectiles["e" .. tostring(data.id)] = {
		part = part,
		origin = origin,
		direction = data.direction,
		speed = data.speed,
		maxDistance = data.speed * data.life,
		startedAt = os.clock(),
		spin = false,
	}
end

handlers.eprojEnd = function(data)
	local key = "e" .. tostring(data.id)
	local moving = projectiles[key]
	if moving then
		projectiles[key] = nil
		local color = moving.part.Color
		moving.part:Destroy()
		if data.hit then
			sphere(data.position, 1, 5, color, 0.25)
		end
	end
end

handlers.telegraph = function(data)
	local position: Vector3 = data.position
	local radius: number = data.radius
	local duration: number = data.duration
	local ground = Vector3.new(position.X, groundAt(position) + 0.2, position.Z)
	local outer = newPart(Vector3.new(0.15, radius * 2, radius * 2), flatDiskCFrame(ground), data.color, Enum.Material.Neon, Enum.PartType.Cylinder)
	outer.Transparency = 0.75
	local inner = newPart(Vector3.new(0.2, 0.5, 0.5), flatDiskCFrame(ground + Vector3.new(0, 0.03, 0)), data.color, Enum.Material.Neon, Enum.PartType.Cylinder)
	inner.Transparency = 0.45
	TweenService:Create(inner, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = Vector3.new(0.2, radius * 2, radius * 2) }):Play()
	Debris:AddItem(outer, duration)
	Debris:AddItem(inner, duration)
end

handlers.slam = function(data)
	local position: Vector3 = data.position
	local radius: number = data.radius
	local ground = Vector3.new(position.X, groundAt(position) + 0.3, position.Z)
	ring(ground, 4, radius * 2.2, data.color, 0.5, 0.1)
	sphere(ground, 4, radius * 1.4, Color3.fromRGB(40, 10, 20), 0.5, Enum.Material.SmoothPlastic, 0.3)
	sparks(ground + Vector3.new(0, 1, 0), Color3.fromRGB(90, 80, 90), 16, radius * 0.7, 1.2)
	shakeNear(position, 2, radius * 4, 0.5)
	Sfx.play("boom", 1, 0.5, position)
end

handlers.chargeLine = function(data)
	local from: Vector3 = data.from
	local to: Vector3 = data.to
	local length = (to - from).Magnitude
	if length < 1 then
		return
	end
	local middle = from:Lerp(to, 0.5)
	local line = newPart(
		Vector3.new(data.width, 0.2, length),
		CFrame.lookAt(Vector3.new(middle.X, groundAt(middle) + 0.25, middle.Z), Vector3.new(to.X, groundAt(middle) + 0.25, to.Z)),
		Color3.fromRGB(255, 50, 60)
	)
	line.Transparency = 0.6
	TweenService:Create(line, TweenInfo.new(0.15, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.25 }):Play()
	Debris:AddItem(line, data.duration)
end

handlers.summon = function(data)
	local position: Vector3 = data.position
	local ground = Vector3.new(position.X, groundAt(position) + 0.2, position.Z)
	ring(ground, 4, data.size * 4, data.color, 0.7, 0.2)
	sphere(position, data.size, data.size * 2, data.color, 0.5, Enum.Material.ForceField, 0)
end

handlers.roar = function(data)
	ring(data.position, data.size, data.size * 5, data.color, 0.6, 0.3)
	shakeNear(data.position, 0.8, 80, 0.5)
end

handlers.death = function(data)
	local position: Vector3 = data.position
	local size: number = data.size
	sphere(position, size * 0.8, size * 2, data.color, 0.35)
	for _ = 1, if data.boss then 24 else 7 do
		local chunk = Instance.new("Part")
		chunk.Size = Vector3.one * size * (0.15 + math.random() * 0.2)
		chunk.Color = data.bodyColor
		chunk.Material = Enum.Material.SmoothPlastic
		chunk.CanCollide = true
		chunk.CanQuery = false
		chunk.CanTouch = false
		chunk.CastShadow = false
		chunk.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * size * 0.5)
		chunk.CollisionGroup = "Default"
		chunk.Parent = folder
		chunk.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 40, 20 + math.random() * 25, (math.random() - 0.5) * 40)
		fadeOut(chunk, 1.4)
	end
	if data.boss then
		colorFlash(Color3.fromRGB(255, 230, 180), 1.5)
		shakeNear(position, 2.5, 200, 1)
		Sfx.play("boom", 1, 0.4, position)
	else
		Sfx.play("hit", 0.3, 0.7, position)
	end
end

handlers.spawn = function(data)
	local position: Vector3 = data.position
	local size: number = data.size
	local ground = Vector3.new(position.X, groundAt(position) + 0.2, position.Z)
	local column = newPart(Vector3.new(size * 1.4, 18, size * 1.4), CFrame.new(ground + Vector3.new(0, 9, 0)), data.color)
	column.Transparency = 0.5
	fadeOut(column, 0.6, { Size = Vector3.new(0.2, 26, 0.2) })
	ring(ground, 1, size * 3, data.color, 0.5, 0.3)
end

handlers.enemyAttack = function(data)
	local position: Vector3 = data.position
	sphere(position, 1, data.size * 0.9, data.color, 0.2)
end

handlers.dmg = function(data)
	local crit = data.crit == true
	local text = Ui.formatNumber(data.amount) .. (if crit then "!" else "")
	floatingText(data.position, text, data.color, if crit then 30 else 22, 4)
end

handlers.heal = function(data)
	floatingText(data.position + Vector3.new(0, 3, 0), "+" .. Ui.formatNumber(data.amount), Ui.GOOD, 20, 3)
	sparks(data.position, Ui.GOOD, 4, 4, 0.4)
end

handlers.hurt = function(data)
	local amount: number = data.amount or 10
	hurtFrame.BackgroundTransparency = math.clamp(0.9 - amount / 60, 0.55, 0.85)
	TweenService:Create(hurtFrame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	FxController.shake(math.clamp(amount / 25, 0.2, 1), 0.2)
	Sfx.play("hurt", 0.3, 1)
end

handlers.sealHit = function(_data)
	local arena = Workspace:FindFirstChild("Arena")
	local temple = arena and arena:FindFirstChild("Templo")
	local crystal = temple and temple:FindFirstChild("SeloSagrado")
	if crystal and crystal:IsA("BasePart") then
		sphere(crystal.Position, 5, 14, Color3.fromRGB(255, 60, 80), 0.35, Enum.Material.ForceField, 0)
	end
	ClientState.Notify:Fire("O SELO ESTÁ SOB ATAQUE!", Color3.fromRGB(255, 90, 110))
end

handlers.sealHeal = function(data)
	sphere(data.position, 4, 18, Ui.GOOD, 0.6, Enum.Material.ForceField, 0)
	sparks(data.position, Ui.GOOD, 12, 8, 0.6)
end

handlers.clear = function(_data)
	for key, moving in projectiles do
		moving.part:Destroy()
		projectiles[key] = nil
	end
end

----------------------------------------------------------------------------
-- Atualização por frame
----------------------------------------------------------------------------

local function onRender()
	local now = os.clock()

	for key, moving in projectiles do
		local traveled = moving.speed * (now - moving.startedAt)
		if traveled > moving.maxDistance + 4 or not moving.part.Parent then
			projectiles[key] = nil
			if moving.part.Parent then
				moving.part:Destroy()
			end
		else
			local position = moving.origin + moving.direction * traveled
			local look = CFrame.lookAt(position, position + moving.direction)
			if moving.spin then
				look *= CFrame.Angles(0, 0, now * 20)
			end
			moving.part.CFrame = look
		end
	end

	for index = #orbiters, 1, -1 do
		local orb = orbiters[index]
		if now >= orb.endsAt then
			fadeOut(orb.part, 0.4)
			table.remove(orbiters, index)
		else
			local angle = orb.offset + now * orb.speed
			orb.part.CFrame = CFrame.new(orb.center + Vector3.new(math.cos(angle) * orb.radius, orb.height + math.sin(now * 3 + orb.offset), math.sin(angle) * orb.radius))
		end
	end

	-- Tremor de câmera via CameraOffset do Humanoid.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if now < shakeUntil then
			local strength = shakeIntensity * math.clamp((shakeUntil - now) * 4, 0, 1)
			humanoid.CameraOffset = Vector3.new(
				(math.random() - 0.5) * strength,
				(math.random() - 0.5) * strength,
				(math.random() - 0.5) * strength
			)
		elseif humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
			shakeIntensity = 0
		end
	end
end

function FxController.init()
	local existing = Workspace:FindFirstChild("FxClient")
	if existing then
		existing:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "FxClient"
	folder.Parent = Workspace

	overlay = Ui.screen("FxOverlay", 50)
	overlay.IgnoreGuiInset = true
	hurtFrame = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(200, 0, 20),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = overlay,
	})
end

function FxController.start()
	Net.event("Fx").OnClientEvent:Connect(function(kind: string, data: { [string]: any })
		local handler = handlers[kind]
		if handler and typeof(data) == "table" then
			local ok, err = pcall(handler, data)
			if not ok then
				warn(`[Fx] erro no efeito {kind}: {err}`)
			end
		end
	end)
	RunService.RenderStepped:Connect(onRender)
end

return FxController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000023">
						<Properties>
							<string name="Name">HudController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Interface principal: onda, Selo, chefe, vida/energia/Território,
-- barra de habilidades com recarga (também são botões no celular),
-- moedas, fragmentos, botões Pronto / Loja / Técnica e dicas de controle.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Techniques = require(Shared:WaitForChild("Techniques"))

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local Ui = require(ClientUtil:WaitForChild("Ui"))
local ClientState = require(ClientUtil:WaitForChild("ClientState"))
local Sfx = require(ClientUtil:WaitForChild("Sfx"))

local player = Players.LocalPlayer

local HudController = {}

type Bar = { frame: Frame, fill: Frame, text: TextLabel }

type Slot = {
	button: TextButton,
	overlay: Frame,
	timer: TextLabel,
	name: TextLabel,
	cost: TextLabel,
	stroke: UIStroke,
}

local gui: ScreenGui
local waveLabel: TextLabel
local phaseLabel: TextLabel
local sealBar: Bar
local bossBar: Bar
local healthBar: Bar
local energyBar: Bar
local ultBar: Bar
local coinsLabel: TextLabel
local fragmentsLabel: TextLabel
local techniqueLabel: TextLabel
local deadLabel: TextLabel
local controlsPanel: Frame
local readyButton: TextButton
local shopButton: TextButton
local awakenButton: TextButton
local slots: { [number]: Slot } = {}

local shown = { health = 1, energy = 1, ult = 0, seal = 1, boss = 1 }

local SLOT_KEYS = { [0] = "Clique", [1] = "Z", [2] = "X", [3] = "C", [4] = "V" }

----------------------------------------------------------------------------

local function buildTop()
	waveLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, Ui.s(6)),
		Size = Ui.px(400, 40),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(34),
		Text = "NOITE MALDITA",
		Parent = gui,
	})
	Ui.textStroke(0.2).Parent = waveLabel

	phaseLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, Ui.s(44)),
		Size = Ui.px(600, 24),
		TextSize = Ui.s(18),
		TextColor3 = Ui.MUTED,
		Parent = gui,
	})
	Ui.textStroke(0.3).Parent = phaseLabel

	sealBar = Ui.bar(gui, Ui.px(380, 20), UDim2.new(0.5, 0, 0, Ui.s(74)), Vector2.new(0.5, 0), Color3.fromRGB(175, 115, 255))
	bossBar = Ui.bar(gui, Ui.px(480, 24), UDim2.new(0.5, 0, 0, Ui.s(102)), Vector2.new(0.5, 0), Color3.fromRGB(230, 40, 70))
	bossBar.frame.Visible = false

	local wallet = Ui.panel({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -Ui.s(12), 0, Ui.s(8)),
		Size = Ui.px(210, 62),
		Parent = gui,
	})
	coinsLabel = Ui.label({
		Position = Ui.px(12, 4),
		Size = Ui.px(190, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.GOLD,
		TextSize = Ui.s(20),
		Font = Ui.FONT_HEAVY,
		Text = "Moedas: 0",
		Parent = wallet,
	})
	fragmentsLabel = Ui.label({
		Position = Ui.px(12, 32),
		Size = Ui.px(190, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.ACCENT,
		TextSize = Ui.s(16),
		Text = "Fragmentos: 0",
		Parent = wallet,
	})
end

local function buildPlayerPanel()
	local panel = Ui.panel({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, Ui.s(14), 1, -Ui.s(14)),
		Size = Ui.px(300, 92),
		Parent = gui,
	})
	healthBar = Ui.bar(panel, Ui.px(276, 24), Ui.px(12, 10), Vector2.zero, Color3.fromRGB(90, 220, 120))
	energyBar = Ui.bar(panel, Ui.px(276, 18), Ui.px(12, 40), Vector2.zero, Color3.fromRGB(80, 150, 255))
	ultBar = Ui.bar(panel, Ui.px(276, 18), Ui.px(12, 64), Vector2.zero, Ui.GOLD)

	if Ui.isTouch() then
		-- No celular o painel sobe para não ficar embaixo do analógico.
		panel.AnchorPoint = Vector2.new(0, 0)
		panel.Position = UDim2.new(0, Ui.s(14), 0, Ui.s(80))
	end
end

local function makeSlot(slot: number, parent: Instance, size: number): Slot
	local button = Ui.button({
		Name = "Slot" .. slot,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Ui.PANEL,
		BackgroundTransparency = 0.15,
		LayoutOrder = slot,
		AutoButtonColor = true,
		Parent = parent,
	})
	local stroke = Ui.stroke(if slot == 4 then Ui.GOLD else Ui.ACCENT, 2, 0.3)
	stroke.Parent = button

	Ui.label({
		Position = UDim2.fromOffset(Ui.s(5), Ui.s(3)),
		Size = UDim2.new(1, -Ui.s(10), 0, Ui.s(16)),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = Ui.s(13),
		TextColor3 = Ui.MUTED,
		Text = if Ui.isTouch() then "" else SLOT_KEYS[slot],
		ZIndex = 3,
		Parent = button,
	})
	local cost = Ui.label({
		Position = UDim2.fromOffset(Ui.s(5), Ui.s(3)),
		Size = UDim2.new(1, -Ui.s(10), 0, Ui.s(16)),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = Ui.s(12),
		TextColor3 = Color3.fromRGB(120, 175, 255),
		ZIndex = 3,
		Parent = button,
	})
	local name = Ui.label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -Ui.s(4)),
		Size = UDim2.new(1, -Ui.s(6), 0.55, 0),
		TextWrapped = true,
		TextSize = Ui.s(12),
		TextYAlignment = Enum.TextYAlignment.Bottom,
		ZIndex = 3,
		Parent = button,
	})
	Ui.textStroke(0.4).Parent = name
	local overlay = Ui.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = button,
	})
	Ui.corner(8).Parent = overlay
	local timer = Ui.label({
		Size = UDim2.fromScale(1, 1),
		TextSize = Ui.s(24),
		Font = Ui.FONT_HEAVY,
		ZIndex = 5,
		Parent = button,
	})
	Ui.textStroke(0.2).Parent = timer

	button.Activated:Connect(function()
		ClientState.SkillRequested:Fire(slot)
	end)

	return { button = button, overlay = overlay, timer = timer, name = name, cost = cost, stroke = stroke }
end

local function buildHotbar()
	local touch = Ui.isTouch()
	local size = Ui.s(if touch then 78 else 74)
	local bar = Ui.new("Frame", {
		Name = "Hotbar",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size * 5 + Ui.s(8) * 4, size),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -Ui.s(16)),
		Parent = gui,
	})
	Ui.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, Ui.s(8)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = bar,
	})
	if touch then
		-- Celular: grade 3x2 acima do botão de pulo, à direita.
		bar.AnchorPoint = Vector2.new(1, 1)
		bar.Position = UDim2.new(1, -Ui.s(16), 1, -Ui.s(150))
		bar.Size = UDim2.fromOffset(size * 3 + Ui.s(8) * 2, size * 2 + Ui.s(8))
		local layout = bar:FindFirstChildOfClass("UIListLayout")
		if layout then
			layout:Destroy()
		end
		Ui.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(size, size),
			CellPadding = UDim2.fromOffset(Ui.s(8), Ui.s(8)),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Parent = bar,
		})
	end

	for slot = 0, 4 do
		slots[slot] = makeSlot(slot, bar, size)
	end

	-- Nome da técnica logo acima da barra (fora dela, para não entrar no layout).
	local barHeight = bar.Size.Y.Offset
	techniqueLabel = Ui.label({
		AnchorPoint = if touch then Vector2.new(1, 1) else Vector2.new(0.5, 1),
		Position = if touch
			then UDim2.new(1, -Ui.s(16), 1, -(Ui.s(150) + barHeight + Ui.s(4)))
			else UDim2.new(0.5, 0, 1, -(Ui.s(16) + barHeight + Ui.s(4))),
		Size = Ui.px(520, 24),
		TextXAlignment = if touch then Enum.TextXAlignment.Right else Enum.TextXAlignment.Center,
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(18),
		Parent = gui,
	})
	Ui.textStroke(0.2).Parent = techniqueLabel
end

local function buildButtons()
	local column = Ui.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -Ui.s(14), 0.45, 0),
		Size = Ui.px(170, 190),
		Parent = gui,
	})
	Ui.new("UIListLayout", {
		Padding = UDim.new(0, Ui.s(8)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		Parent = column,
	})

	readyButton = Ui.button({
		Size = Ui.px(170, 50),
		BackgroundColor3 = Color3.fromRGB(40, 120, 70),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(18),
		Text = "PRONTO",
		LayoutOrder = 1,
		Parent = column,
	})
	Ui.stroke(Ui.GOOD, 2, 0.3).Parent = readyButton
	readyButton.Activated:Connect(function()
		Sfx.play("ui", 0.4)
		Net.event("ToggleReady"):FireServer()
	end)

	shopButton = Ui.button({
		Size = Ui.px(170, 50),
		BackgroundColor3 = Color3.fromRGB(110, 80, 20),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(18),
		Text = if Ui.isTouch() then "LOJA" else "LOJA [B]",
		LayoutOrder = 2,
		Parent = column,
	})
	Ui.stroke(Ui.GOLD, 2, 0.3).Parent = shopButton
	shopButton.Activated:Connect(function()
		ClientState.ToggleShop:Fire()
	end)

	awakenButton = Ui.button({
		Size = Ui.px(170, 50),
		BackgroundColor3 = Color3.fromRGB(70, 40, 120),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(18),
		Text = if Ui.isTouch() then "TÉCNICA" else "TÉCNICA [T]",
		LayoutOrder = 3,
		Parent = column,
	})
	Ui.stroke(Ui.ACCENT, 2, 0.3).Parent = awakenButton
	awakenButton.Activated:Connect(function()
		ClientState.ToggleAwaken:Fire()
	end)
end

local function buildExtras()
	deadLabel = Ui.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = Ui.px(700, 40),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(24),
		TextColor3 = Ui.BAD,
		Text = "Você caiu! Volta quando a onda acabar.",
		Visible = false,
		Parent = gui,
	})
	Ui.textStroke(0.2).Parent = deadLabel

	controlsPanel = Ui.panel({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, Ui.s(14), 0.42, 0),
		Size = Ui.px(270, 190),
		Parent = gui,
	})
	Ui.padding(12).Parent = controlsPanel
	local touch = Ui.isTouch()
	local text = if touch
		then "COMO JOGAR\n\n• Toque nos botões à direita para atacar\n• Mire: o golpe vai na maldição mais perto\n• Proteja o cristal roxo (Selo)\n• Entre as ondas, compre na LOJA"
		else "COMO JOGAR\n\nClique (segure): golpe em combo\nZ / X / C: habilidades da técnica\nV: Território (quando a barra dourada encher)\nB: loja  •  T: técnica\n\nProteja o cristal roxo (Selo Sagrado)!"
	Ui.label({
		Size = UDim2.fromScale(1, 1),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextSize = Ui.s(15),
		Font = Ui.FONT_BODY,
		Text = text,
		Parent = controlsPanel,
	})
end

----------------------------------------------------------------------------

local function refreshTechnique()
	local technique = Techniques.byId[player:GetAttribute("Technique") :: string? or ""]
	if not technique then
		techniqueLabel.Text = "Despertando técnica..."
		techniqueLabel.TextColor3 = Ui.MUTED
		return
	end
	local rarity = Techniques.RARITY[technique.rarity]
	techniqueLabel.Text = `{technique.name}  •  {rarity.name}`
	techniqueLabel.TextColor3 = rarity.color
	slots[0].name.Text = "Golpe"
	for index = 1, 3 do
		local skill = technique.skills[index]
		slots[index].name.Text = skill.name
		slots[index].cost.Text = tostring(skill.cost)
		slots[index].stroke.Color = technique.color
	end
	slots[4].name.Text = "Território"
end

local function refreshWallet()
	coinsLabel.Text = "Moedas: " .. Ui.formatNumber((player:GetAttribute("Coins") :: number?) or 0)
	fragmentsLabel.Text = "Fragmentos: " .. Ui.formatNumber((player:GetAttribute("Fragments") :: number?) or 0)
end

local function refreshPhase()
	local phase = GameState.phase()
	local wave = GameState.get("Wave") :: number
	local countdown = GameState.get("Countdown") :: number
	local ready = GameState.get("ReadyCount") :: number
	local total = GameState.get("PlayerCount") :: number
	local inMatch = player:GetAttribute("InMatch") == true

	if phase == "Lobby" then
		waveLabel.Text = "NOITE MALDITA"
		phaseLabel.Text = if countdown > 0
			then `A noite começa em {countdown}s  •  prontos: {ready}/{total}`
			else "Esperando jogadores..."
	elseif phase == "Wave" then
		waveLabel.Text = `ONDA {wave}`
		phaseLabel.Text = `{GameState.get("EnemiesLeft")} maldições restantes`
	elseif phase == "Shop" then
		waveLabel.Text = `ONDA {wave} CONCLUÍDA`
		phaseLabel.Text = `Loja aberta  •  próxima onda em {countdown}s  •  prontos: {ready}/{total}`
	else
		waveLabel.Text = "FIM DA NOITE"
		phaseLabel.Text = `Nova noite em {countdown}s`
	end

	local isReady = player:GetAttribute("Ready") == true
	readyButton.Visible = phase == "Lobby" or phase == "Shop"
	readyButton.Text = if isReady then "PRONTO ✓" else "PRONTO"
	readyButton.BackgroundColor3 = if isReady then Color3.fromRGB(60, 170, 95) else Color3.fromRGB(40, 90, 60)
	shopButton.Visible = inMatch and (phase == "Wave" or phase == "Shop")
	awakenButton.Visible = phase == "Lobby" or phase == "GameOver"
	controlsPanel.Visible = phase == "Lobby"
	sealBar.frame.Visible = phase ~= "Lobby"
	coinsLabel.Visible = phase ~= "Lobby"
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function onRender(dt: number)
	local t = math.min(1, dt * 10)

	-- Vida
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local health, maxHealth = 0, 100
	if humanoid then
		health, maxHealth = humanoid.Health, math.max(1, humanoid.MaxHealth)
	end
	shown.health = lerp(shown.health, health / maxHealth, t)
	healthBar.fill.Size = UDim2.fromScale(math.clamp(shown.health, 0, 1), 1)
	healthBar.fill.BackgroundColor3 = Color3.fromRGB(230, 60, 70):Lerp(Color3.fromRGB(90, 220, 120), math.clamp(shown.health * 1.4 - 0.2, 0, 1))
	healthBar.text.Text = `Vida  {math.ceil(health)} / {math.floor(maxHealth)}`

	local alive = humanoid ~= nil and health > 0
	deadLabel.Visible = not alive and GameState.phase() == "Wave" and player:GetAttribute("InMatch") == true

	-- Energia
	local energy = (player:GetAttribute("Energy") :: number?) or 0
	local maxEnergy = (player:GetAttribute("MaxEnergy") :: number?) or Config.ENERGY_MAX
	shown.energy = lerp(shown.energy, energy / maxEnergy, t)
	energyBar.fill.Size = UDim2.fromScale(math.clamp(shown.energy, 0, 1), 1)
	energyBar.text.Text = `Energia  {energy}`

	-- Território
	local ult = (player:GetAttribute("Ult") :: number?) or 0
	shown.ult = lerp(shown.ult, ult / Config.ULT_MAX, t)
	ultBar.fill.Size = UDim2.fromScale(math.clamp(shown.ult, 0, 1), 1)
	local ultReady = ult >= Config.ULT_MAX
	if ultReady then
		local pulse = 0.5 + 0.5 * math.sin(os.clock() * 8)
		ultBar.text.Text = if Ui.isTouch() then "TERRITÓRIO PRONTO!" else "TERRITÓRIO PRONTO! [V]"
		ultBar.fill.BackgroundColor3 = Ui.GOLD:Lerp(Color3.new(1, 1, 1), pulse * 0.5)
		slots[4].stroke.Transparency = 0
		slots[4].stroke.Thickness = Ui.s(2) + pulse * Ui.s(2)
	else
		ultBar.text.Text = `Território  {math.floor(ult)}%`
		ultBar.fill.BackgroundColor3 = Ui.GOLD
		slots[4].stroke.Transparency = 0.3
		slots[4].stroke.Thickness = Ui.s(2)
	end

	-- Selo e chefe
	local seal = GameState.get("SealHealth") :: number
	local sealMax = math.max(1, GameState.get("SealMaxHealth") :: number)
	shown.seal = lerp(shown.seal, seal / sealMax, t)
	sealBar.fill.Size = UDim2.fromScale(math.clamp(shown.seal, 0, 1), 1)
	sealBar.text.Text = `Selo Sagrado  {seal} / {sealMax}`
	sealBar.fill.BackgroundColor3 = Color3.fromRGB(255, 60, 80):Lerp(Color3.fromRGB(175, 115, 255), math.clamp(seal / sealMax * 1.5 - 0.2, 0, 1))

	local bossName = GameState.get("BossName") :: string
	bossBar.frame.Visible = bossName ~= ""
	if bossName ~= "" then
		local bossHealth = GameState.get("BossHealth") :: number
		local bossMax = math.max(1, GameState.get("BossMaxHealth") :: number)
		shown.boss = lerp(shown.boss, bossHealth / bossMax, t)
		bossBar.fill.Size = UDim2.fromScale(math.clamp(shown.boss, 0, 1), 1)
		bossBar.text.Text = `{bossName}  •  {Ui.formatNumber(bossHealth)}`
	end

	-- Recargas
	local now = os.clock()
	local technique = Techniques.byId[player:GetAttribute("Technique") :: string? or ""]
	for slot = 1, 4 do
		local data = slots[slot]
		local endsAt = ClientState.cooldownEnds[slot] or 0
		local total = ClientState.cooldownTotals[slot] or 1
		local remaining = endsAt - now
		if remaining > 0 then
			data.overlay.Size = UDim2.fromScale(1, math.clamp(remaining / total, 0, 1))
			data.timer.Text = if remaining >= 10 then tostring(math.ceil(remaining)) else string.format("%.1f", remaining)
		else
			data.overlay.Size = UDim2.fromScale(1, 0)
			data.timer.Text = ""
		end
		-- Sem energia suficiente: botão escurece.
		if slot <= 3 and technique then
			local skill = technique.skills[slot]
			data.button.BackgroundColor3 = if energy >= skill.cost then Ui.PANEL else Color3.fromRGB(45, 20, 30)
		elseif slot == 4 then
			data.button.BackgroundColor3 = if ultReady then Color3.fromRGB(70, 55, 15) else Ui.PANEL
		end
	end
end

function HudController.init()
	gui = Ui.screen("HUD", 10)
	buildTop()
	buildPlayerPanel()
	buildHotbar()
	buildButtons()
	buildExtras()
end

function HudController.start()
	refreshTechnique()
	refreshWallet()
	refreshPhase()

	player:GetAttributeChangedSignal("Technique"):Connect(refreshTechnique)
	player:GetAttributeChangedSignal("Coins"):Connect(refreshWallet)
	player:GetAttributeChangedSignal("Fragments"):Connect(refreshWallet)
	player:GetAttributeChangedSignal("Ready"):Connect(refreshPhase)
	player:GetAttributeChangedSignal("InMatch"):Connect(refreshPhase)
	for _, key in { "Phase", "Wave", "Countdown", "EnemiesLeft", "ReadyCount", "PlayerCount" } do
		GameState.onChanged(key, refreshPhase)
	end

	RunService.RenderStepped:Connect(onRender)
end

return HudController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000024">
						<Properties>
							<string name="Name">InputController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Controles: teclado/mouse, controle (gamepad) e botões na tela (celular).
-- Calcula a mira e manda o pedido ao servidor. Também executa o
-- movimento da investida (dash) quando o servidor confirma.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local ClientState = require(ClientUtil:WaitForChild("ClientState"))

local player = Players.LocalPlayer

local InputController = {}

local holdingAttack = false
local dashConnection: RBXScriptConnection? = nil

local KEY_TO_SLOT: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.Z] = 1,
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.X] = 2,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.C] = 3,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.V] = 4,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.ButtonX] = 1,
	[Enum.KeyCode.ButtonY] = 2,
	[Enum.KeyCode.ButtonB] = 3,
	[Enum.KeyCode.ButtonL1] = 4,
}

local function getRoot(): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function isAlive(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function raycastParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local fx = Workspace:FindFirstChild("FxClient")
	if fx then
		table.insert(ignore, fx)
	end
	params.FilterDescendantsInstances = ignore
	return params
end

-- Mira automática: a maldição mais perto à frente da câmera.
local function autoAim(root: BasePart): Vector3
	local camera = Workspace.CurrentCamera
	local look = if camera then camera.CFrame.LookVector else root.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = if flatLook.Magnitude > 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)

	local enemies = Workspace:FindFirstChild("Enemies")
	local best: Vector3? = nil
	local bestScore = math.huge
	if enemies then
		for _, model in enemies:GetChildren() do
			if model:IsA("Model") and model.PrimaryPart then
				local position = model.PrimaryPart.Position
				local offset = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
				local distance = offset.Magnitude
				if distance < 75 and distance > 0.1 then
					local facing = offset.Unit:Dot(flatLook)
					-- Prefere quem está perto e na frente.
					local score = distance * (1.6 - facing)
					if score < bestScore then
						bestScore = score
						best = position
					end
				end
			end
		end
	end
	return best or (root.Position + flatLook * 40)
end

local function aimPoint(root: BasePart): Vector3
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	local gamepad = UserInputService:GetLastInputType().Name:find("Gamepad") ~= nil
	if touchOnly or gamepad then
		return autoAim(root)
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return autoAim(root)
	end
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, raycastParams())
	return if result then result.Position else ray.Origin + ray.Direction * 200
end

local function request(slot: number)
	if not isAlive() then
		return
	end
	local root = getRoot()
	if not root then
		return
	end
	local now = os.clock()
	local endsAt = ClientState.cooldownEnds[slot]
	if endsAt and now < endsAt - 0.05 then
		return
	end

	local aim = aimPoint(root)
	local flatTarget = Vector3.new(aim.X, root.Position.Y, aim.Z)
	if (flatTarget - root.Position).Magnitude > 1 then
		root.CFrame = CFrame.lookAt(root.Position, flatTarget)
	end
	if slot == 0 then
		ClientState.cooldownEnds[0] = now + Config.M1_COOLDOWN
	end
	Net.event("UseSkill"):FireServer(slot, aim)
end

local function startHoldingAttack()
	if holdingAttack then
		return
	end
	holdingAttack = true
	task.spawn(function()
		while holdingAttack do
			request(0)
			task.wait(Config.M1_COOLDOWN + 0.02)
		end
	end)
end

local function performDash(movement: Vector3)
	local root = getRoot()
	if not root or movement.Magnitude < 0.5 then
		return
	end
	local direction = Vector3.new(movement.X, 0, movement.Z)
	if direction.Magnitude < 0.1 then
		return
	end
	direction = direction.Unit
	local distance = movement.Magnitude
	local params = raycastParams()
	local enemies = Workspace:FindFirstChild("Enemies")
	if enemies then
		local list = params.FilterDescendantsInstances
		table.insert(list, enemies)
		params.FilterDescendantsInstances = list
	end
	local hit = Workspace:Raycast(root.Position, direction * distance, params)
	if hit then
		distance = math.max(0, (hit.Position - root.Position).Magnitude - 2)
	end
	local start = root.Position
	local target = start + direction * distance
	local duration = 0.18
	local elapsed = 0
	if dashConnection then
		dashConnection:Disconnect()
	end
	dashConnection = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		local alpha = math.min(1, elapsed / duration)
		local currentRoot = getRoot()
		if not currentRoot then
			if dashConnection then
				dashConnection:Disconnect()
			end
			return
		end
		local position = start:Lerp(target, alpha)
		currentRoot.CFrame = CFrame.lookAt(position, position + direction)
		currentRoot.AssemblyLinearVelocity = Vector3.zero
		if alpha >= 1 and dashConnection then
			dashConnection:Disconnect()
			dashConnection = nil
		end
	end)
end

local function onSkillResult(slot: number, cooldown: number, extra: { [string]: any }?)
	if typeof(slot) ~= "number" or typeof(cooldown) ~= "number" then
		return
	end
	ClientState.cooldownEnds[slot] = os.clock() + cooldown
	ClientState.cooldownTotals[slot] = cooldown
	if extra and typeof(extra.dash) == "Vector3" then
		performDash(extra.dash)
	end
end

function InputController.start()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
			startHoldingAttack()
			return
		end
		local slot = KEY_TO_SLOT[input.KeyCode]
		if slot then
			request(slot)
		elseif input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.DPadUp then
			ClientState.ToggleShop:Fire()
		elseif input.KeyCode == Enum.KeyCode.T or input.KeyCode == Enum.KeyCode.DPadDown then
			ClientState.ToggleAwaken:Fire()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonR2 then
			holdingAttack = false
		end
	end)

	-- Se a janela perder o foco com o botão apertado, para de atacar.
	UserInputService.WindowFocusReleased:Connect(function()
		holdingAttack = false
	end)

	ClientState.SkillRequested:Connect(request)
	Net.event("SkillResult").OnClientEvent:Connect(onSkillResult)
end

return InputController
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX00000025">
						<Properties>
							<string name="Name">ShopController</string>
							<ProtectedString name="Source"><![CDATA[--!strict
-- Janela da loja entre ondas. Mostra preço e nível de cada melhoria;
-- o clique só manda o pedido — quem cobra e aplica é o servidor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameState = require(Shared:WaitForChild("GameState"))
local Net = require(Shared:WaitForChild("Net"))
local Upgrades = require(Shared:WaitForChild("Upgrades"))

local ClientUtil = script.Parent.Parent:WaitForChild("Util")
local Ui = require(ClientUtil:WaitForChild("Ui"))
local ClientState = require(ClientUtil:WaitForChild("ClientState"))
local Sfx = require(ClientUtil:WaitForChild("Sfx"))

local player = Players.LocalPlayer

local ShopController = {}

type Row = { level: TextLabel, buy: TextButton, upgrade: any }

local gui: ScreenGui
local panel: Frame
local coinsLabel: TextLabel
local rows: { Row } = {}

local function canOpen(): boolean
	local phase = GameState.phase()
	return player:GetAttribute("InMatch") == true and (phase == "Wave" or phase == "Shop")
end

local function refresh()
	local coins = (player:GetAttribute("Coins") :: number?) or 0
	coinsLabel.Text = "Moedas: " .. Ui.formatNumber(coins)
	for _, row in rows do
		local upgrade = row.upgrade
		local level = (player:GetAttribute("Up_" .. upgrade.id) :: number?) or 0
		local maxed = level >= upgrade.maxLevel
		if upgrade.team then
			row.level.Text = "Time"
		else
			row.level.Text = `Nv {level}/{upgrade.maxLevel}`
		end
		if maxed then
			row.buy.Text = "MÁX"
			row.buy.BackgroundColor3 = Color3.fromRGB(60, 55, 70)
		else
			local cost = Upgrades.cost(upgrade, level)
			row.buy.Text = Ui.formatNumber(cost)
			row.buy.BackgroundColor3 = if coins >= cost then Color3.fromRGB(45, 140, 75) else Color3.fromRGB(90, 40, 50)
		end
	end
end

local function setOpen(open: boolean)
	if open and not canOpen() then
		ClientState.Notify:Fire("A loja abre quando a partida começa.", Color3.fromRGB(255, 200, 120))
		return
	end
	panel.Visible = open
	if open then
		refresh()
	end
end

local function build()
	gui = Ui.screen("Shop", 20)
	panel = Ui.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = Ui.px(520, 470),
		Visible = false,
		Parent = gui,
	})
	Ui.padding(16).Parent = panel

	local title = Ui.label({
		Size = UDim2.new(1, 0, 0, Ui.s(34)),
		Font = Ui.FONT_HEAVY,
		TextSize = Ui.s(28),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "LOJA DO TEMPLO",
		TextColor3 = Ui.GOLD,
		Parent = panel,
	})
	Ui.textStroke(0.3).Parent = title

	coinsLabel = Ui.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -Ui.s(44), 0, 0),
		Size = Ui.px(200, 34),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Ui.GOLD,
		TextSize = Ui.s(20),
		Parent = panel,
	})

	local close = Ui.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = Ui.px(34, 34),
		Text = "X",
		BackgroundColor3 = Color3.fromRGB(90, 40, 50),
		Parent = panel,
	})
	close.Activated:Connect(function()
		setOpen(false)
	end)

	local list = Ui.new("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, Ui.s(46)),
		Size = UDim2.new(1, 0, 1, -Ui.s(46)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = Ui.s(6),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Ui.new("UIListLayout", {
		Padding = UDim.new(0, Ui.s(8)),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})

	for index, upgrade in Upgrades.list do
		local row = Ui.new("Frame", {
			Size = UDim2.new(1, -Ui.s(10), 0, Ui.s(62)),
			BackgroundColor3 = Ui.PANEL_LIGHT,
			BackgroundTransparency = 0.2,
			LayoutOrder = index,
			Parent = list,
		})
		Ui.corner(8).Parent = row
		Ui.label({
			Position = Ui.px(12, 6),
			Size = UDim2.new(1, -Ui.s(200), 0, Ui.s(24)),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Ui.FONT_HEAVY,
			TextSize = Ui.s(19),
			Text = upgrade.name,
			Parent = row,
		})
		Ui.label({
			Position = Ui.px(12, 32),
			Size = UDim2.new(1, -Ui.s(200), 0, Ui.s(22)),
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Ui.FONT_BODY,
			TextSize = Ui.s(14),
			TextColor3 = Ui.MUTED,
			Text = upgrade.description,
			Parent = row,
		})
		local level = Ui.label({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -Ui.s(120), 0.5, 0),
			Size = Ui.px(70, 24),
			TextSize = Ui.s(15),
			TextColor3 = Ui.ACCENT,
			Parent = row,
		})
		local buy = Ui.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -Ui.s(10), 0.5, 0),
			Size = Ui.px(100, 42),
			Font = Ui.FONT_HEAVY,
			TextSize = Ui.s(18),
			Parent = row,
		})
		buy.Activated:Connect(function()
			Sfx.play("ui", 0.4)
			Net.event("BuyUpgrade"):FireServer(upgrade.id)
		end)
		table.insert(rows, { level = level, buy = buy, upgrade = upgrade })
	end
end

function ShopController.init()
	build()
end

function ShopController.start()
	ClientState.ToggleShop:Connect(function()
		setOpen(not panel.Visible)
	end)
	player:GetAttributeChangedSignal("Coins"):Connect(refresh)
	for _, upgrade in Upgrades.list do
		player:GetAttributeChangedSignal("Up_" .. upgrade.id):Connect(refresh)
	end
	GameState.onChanged("Phase", function()
		local phase = GameState.phase()
		if phase == "Shop" and player:GetAttribute("InMatch") == true then
			setOpen(true)
		elseif phase ~= "Shop" then
			panel.Visible = false
		end
	end)
	refresh()
end

return ShopController
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Folder" referent="RBX00000026">
					<Properties>
						<string name="Name">Util</string>
