		speed = 25,
		size = 2.6,
		attackRange = 4,
		attackCooldown = 0.8,
		coins = 7,
		color = Color3.fromRGB(30, 60, 55),
		eyeColor = Color3.fromRGB(80, 255, 170),
		eyes = 1,
		horns = false,
	},
	bruta = {
		id = "bruta",
		name = "Maldição Bruta",
		kind = "melee",
		health = 230,
		damage = 20,
		speed = 9,
		size = 6,
		attackRange = 6,
		attackCooldown = 1.6,
		coins = 14,
		color = Color3.fromRGB(75, 30, 35),
		eyeColor = Color3.fromRGB(255, 150, 40),
		eyes = 3,
		horns = true,
	},
	cuspidora = {
		id = "cuspidora",
		name = "Maldição Cuspidora",
		kind = "ranged",
		health = 90,
		damage = 12,
		speed = 11,
		size = 4,
		attackRange = 46,
		attackCooldown = 2.4,
		coins = 10,
		color = Color3.fromRGB(45, 65, 35),
		eyeColor = Color3.fromRGB(200, 255, 60),
		eyes = 4,
		horns = false,
		preferredRange = 28,
		projectileSpeed = 55,
	},
	devorador = {
		id = "devorador",
		name = "Devorador de Selos",
		kind = "boss",
		health = 2600,
		damage = 32,
		speed = 8,
		size = 14,
		attackRange = 10,
		attackCooldown = 2,
		coins = 150,
		color = Color3.fromRGB(40, 15, 30),
		eyeColor = Color3.fromRGB(255, 40, 80),
		eyes = 5,
		horns = true,
		abilities = { "slam", "charge", "slam", "summon" },
		abilityCooldown = 6,
	},
	rainha = {
		id = "rainha",
		name = "Rainha das Mil Bocas",
		kind = "boss",
		health = 2300,
		damage = 26,
		speed = 9,
		size = 12,
		attackRange = 9,
		attackCooldown = 1.8,
		coins = 160,
		color = Color3.fromRGB(25, 20, 55),
		eyeColor = Color3.fromRGB(170, 90, 255),
		eyes = 7,
		horns = true,
		abilities = { "volley", "summon", "slam", "volley", "charge" },
		abilityCooldown = 5,
		projectileSpeed = 50,
	},
} :: { [string]: EnemyDef }

return Enemies
]]></ProtectedString>
